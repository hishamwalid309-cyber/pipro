/* -------------------------------------------------------------------- RTL */
html[dir="rtl"] body { direction: rtl; }
html[dir="rtl"] .dock { left: auto; right: 16px; }
html[dir="rtl"] .dock__btn.is-active::before { left: auto; right: -9px; }
