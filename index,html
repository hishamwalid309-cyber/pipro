/* ------------------------------------------------------------- lang/account */
.lang-btn {
  width: 36px; height: 36px; border-radius: 11px; display: grid; place-items: center;
  border: 1px solid var(--line-strong); color: var(--text); font-size: 12.5px; font-weight: 600;
  background: var(--surface); transition: 0.22s var(--ease); position: relative; overflow: hidden;
}
.lang-btn:hover { border-color: var(--accent); color: var(--accent); }

.account {
  display: flex; align-items: center; gap: 8px; padding: 5px 12px 5px 6px;
  border-radius: 99px; border: 1px solid var(--line-strong); background: var(--surface);
  transition: 0.22s var(--ease); max-width: 210px;
}
.account:hover { border-color: var(--accent); }
.account__av {
  width: 26px; height: 26px; border-radius: 50%; flex: 0 0 26px; display: grid; place-items: center;
  font-size: 11px; font-weight: 700; color: var(--accent-ink);
  background: linear-gradient(140deg, var(--accent), var(--accent-2)); background-size: cover; background-position: center;
}
.account__name { font-size: 12px; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.account__dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent-2); box-shadow: 0 0 0 3px color-mix(in oklab, var(--accent-2) 25%, transparent); }
.account[data-role="admin"] .account__dot { background: #46d39a; box-shadow: 0 0 0 3px rgba(70, 211, 154, 0.25); }

/* ------------------------------------------------------------------ modals */
.modal {
  position: fixed; inset: 0; z-index: 85; display: grid; place-items: center;
  padding: 20px; background: rgba(3, 6, 12, 0.66);
  backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
  opacity: 0; transition: opacity 0.24s var(--ease);
}
.modal.is-open { opacity: 1; }
.modal__card {
  position: relative; width: min(430px, 94vw); max-height: 92vh; overflow-y: auto;
  padding: 26px; display: flex; flex-direction: column; gap: 10px;
  transform: translateY(10px) scale(0.985); transition: transform 0.32s var(--ease);
}
.modal.is-open .modal__card { transform: none; }
.modal__x { position: absolute; top: 12px; right: 12px; }
html[dir="rtl"] .modal__x { right: auto; left: 12px; }
.modal__card h2 { font-size: 20px; font-weight: 600; letter-spacing: -0.02em; }
.modal__card > p { font-size: 12.6px; color: var(--muted); line-height: 1.6; }
.auth__mark {
  width: 52px; height: 52px; border-radius: 15px; display: grid; place-items: center;
  background: color-mix(in oklab, var(--accent) 12%, transparent);
  border: 1px solid color-mix(in oklab, var(--accent) 26%, transparent); margin-bottom: 2px;
}
.auth__google { margin-top: 8px; }
.auth__or { display: flex; align-items: center; gap: 10px; font-size: 10.5px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); margin: 4px 0; }
.auth__or::before, .auth__or::after { content: ""; flex: 1; height: 1px; background: var(--line); }
.auth__guest { align-self: center; font-size: 12px; margin-top: 6px; }
.gsi { display: flex; justify-content: center; }
.gsi:empty { display: none; }
.hint {
  font-size: 11.4px; line-height: 1.55; color: #f0b862; background: rgba(240, 184, 98, 0.08);
  border: 1px solid rgba(240, 184, 98, 0.22); border-radius: 9px; padding: 8px 10px;
}
.modal--wide .modal__card { width: min(760px, 96vw); }
.admin { padding: 0; gap: 0; }
.admin__head { padding: 22px 22px 12px; display: flex; justify-content: space-between; gap: 12px; border-bottom: 1px solid var(--line); }
.admin__head h2 { font-size: 18px; margin: 3px 0 4px; }
.admin__head p { font-size: 11.6px; color: var(--muted); max-width: 52ch; }
