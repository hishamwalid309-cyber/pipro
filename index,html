<script>
/* ---- sound.js ---- */
/* =============================================================================
   sound.js — calm, premium UI feedback built on the Web Audio API.
   No audio files: every sound is synthesised, so the app stays one small bundle.
   ============================================================================= */
window.QG = window.QG || {};

(function (QG) {
  'use strict';

  let ctx = null;
  let master = null;
  let enabled = true;
  let lastAt = 0;

  function build() {
    const AC = window.AudioContext || window.webkitAudioContext;
    if (!AC) return null;
    if (!ctx) {
      ctx = new AC();
      master = ctx.createGain();
      master.gain.value = 0.9;

      const comp = ctx.createDynamicsCompressor();
      comp.threshold.value = -22;
      comp.knee.value = 22;
      comp.ratio.value = 6;
      comp.attack.value = 0.004;
      comp.release.value = 0.18;

      const shelf = ctx.createBiquadFilter();     // tame the top end: soft, not clicky
      shelf.type = 'lowpass';
      shelf.frequency.value = 5200;
      shelf.Q.value = 0.5;

      master.connect(shelf);
      shelf.connect(comp);
      comp.connect(ctx.destination);
    }
    if (ctx.state === 'suspended') ctx.resume();
    return ctx;
  }

  /* One shaped tone: quick attack, exponential release — feels like a soft key. */
  function tone(opts) {
    if (!enabled) return;
    const c = build();
    if (!c) return;

    const t0 = c.currentTime + (opts.delay || 0);
    const dur = opts.dur || 0.09;
    const osc = c.createOscillator();
    const gain = c.createGain();
    const lp = c.createBiquadFilter();
    const peak = opts.gain == null ? 0.05 : opts.gain;

    osc.type = opts.type || 'triangle';
    osc.frequency.setValueAtTime(opts.freq, t0);
    if (opts.glide) {
      osc.frequency.exponentialRampToValueAtTime(Math.max(40, opts.freq + opts.glide), t0 + dur * 0.85);
    }

    lp.type = 'lowpass';
    lp.frequency.setValueAtTime(opts.filter || 2400, t0);

    gain.gain.setValueAtTime(0.0001, t0);
    gain.gain.exponentialRampToValueAtTime(peak, t0 + 0.008);
    gain.gain.exponentialRampToValueAtTime(0.0001, t0 + dur);

    osc.connect(lp);
    lp.connect(gain);
    gain.connect(master);
    osc.start(t0);
    osc.stop(t0 + dur + 0.02);
  }

  const api = {
    get enabled() { return enabled; },

    setEnabled(v) {
      enabled = !!v;
      if (enabled) build();
      return enabled;
    },

    /** Primary click — two layers: a warm body and a tiny air transient. */
    click(strength) {
      if (!enabled) return;
      const now = performance.now();
      if (now - lastAt < 45) return;            // de-bounce accidental doubles
      lastAt = now;
      const s = strength || 1;
      tone({ freq: 392 * s, glide: -60, dur: 0.11, gain: 0.045, type: 'sine', filter: 1100 });
      tone({ freq: 880 * s, dur: 0.045, gain: 0.018, type: 'triangle', filter: 3200, delay: 0.004 });
    },

    /** Very quiet tick used on hover of key elements. */
    tick() {
      tone({ freq: 1320, dur: 0.028, gain: 0.008, type: 'sine', filter: 3600 });
    },

    /** Page / view transition. */
    swoosh() {
      tone({ freq: 220, glide: 180, dur: 0.32, gain: 0.032, type: 'sine', filter: 900 });
      tone({ freq: 660, glide: 240, dur: 0.22, gain: 0.014, type: 'triangle', filter: 2600, delay: 0.03 });
    },

    /** Generation finished. */
    success() {
      [523.25, 659.25, 783.99].forEach((f, i) => {
        tone({ freq: f, dur: 0.34, gain: 0.032, type: 'sine', filter: 2200, delay: i * 0.075 });
      });
    },

    /** Something went wrong — low, non-alarming. */
    error() {
      tone({ freq: 180, glide: -50, dur: 0.22, gain: 0.05, type: 'sine', filter: 700 });
    },

    /** Soft heartbeat while a long job runs. */
    pulse() {
      tone({ freq: 240, dur: 0.14, gain: 0.018, type: 'sine', filter: 800 });
    }
  };

  QG.sound = api;

  /* Unlock audio on the very first gesture (browser autoplay policy). */
  ['pointerdown', 'keydown', 'touchstart'].forEach(function (ev) {
    document.addEventListener(ev, function once() {
      if (enabled) build();
      document.removeEventListener(ev, once);
    }, { once: true, passive: true });
  });
})(window.QG);

</script>
