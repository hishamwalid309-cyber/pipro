  }

  /* ----------------------------------------------------------------- plans */
  function price(plan) { return st().period === 'yearly' ? plan.yearly : plan.monthly; }

  function curPlan() {
    const plans = site().plans;
    const plan = plans.find(p => p.id === st().plan) || plans[1] || plans[0];
    return { plan, value: price(plan) };
  }

  function renderPlans() {
    const wrap = U.$('#plans');
    if (!wrap) return;
    wrap.innerHTML = '';
    site().plans.forEach(p => {
      const value = price(p);
      const card = U.el('button', { class: 'plan' + (p.featured ? ' is-featured' : '') + (p.id === st().plan ? ' is-active' : '') });
      card.innerHTML =
        '<span class="plan__name">' + U.esc(p.name) + '</span>' +
        '<span class="plan__price"><b>' + (value === 0 ? t('common.free') : U.num(value, 'plain')) + '</b><span>' +
        (p.preview ? t('plan.previewTag') : value === 0 ? t('common.forever') : st().period === 'yearly' ? t('common.perYear') : t('common.perMonth')) + '</span></span>' +
        '<span class="plan__note">' + U.esc(p.note || '') + '</span>' +
        '<ul class="plan__list">' + (p.features || []).map(f => '<li>' + U.esc(f) + '</li>').join('') + '</ul>' +
        '<span class="btn ' + (p.id === st().plan ? 'btn--primary' : 'btn--ghost') + ' btn--sm btn--block plan__pick">' +
        (p.id === st().plan ? t('plan.selected') : t('plan.choose', { name: p.name })) + '</span>';
      card.addEventListener('click', () => {
        st().plan = p.id;
        renderPlans();
        updateCheckout();
        QG.sound.click();
        U.$('#checkout').scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
      wrap.appendChild(card);
    });
  }

  /* ------------------------------------------------------------- checkout */
  function payerRow(k, v, copy) {
    return '<div class="payrow"><span class="payrow__k">' + U.esc(k) + '</span>' +
      '<span class="payrow__v">' + U.esc(v) +
      (copy ? ' <button data-copy="' + U.esc(v) + '">' + t('common.copy') + '</button>' : '') + '</span></div>';
  }

  function waRow(text) {
    return '<a class="payrow payrow--wa" href="' + waLink(null) + '" target="_blank" rel="noopener">' +
      '<span class="payrow__k">' + t('pay.waRow') + '</span>' +
      '<span class="payrow__v">' + waPretty() + ' <span class="wa-icon" aria-hidden="true">' +
      '<svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.1-1.3A10 10 0 1 0 12 2zm0 18a8 8 0 0 1-4.1-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8 8 0 1 1 12 20zm4.5-5.9c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.5.1l-.7.9c-.1.2-.3.2-.5.1a6.5 6.5 0 0 1-3.2-2.8c-.1-.2 0-.4.1-.5l.6-.7c.1-.2.1-.3 0-.5l-.7-1.7c-.1-.3-.3-.3-.5-.3h-.5c-.2 0-.5.1-.7.3-.7.7-.9 1.6-.7 2.6.4 1.9 1.8 3.6 3.6 4.5 1.5.8 2.6.8 3.3.7.5-.1.9-.5 1.1-.9.2-.4.2-.8.1-.9z"/></svg>' +
      '</span></a>' +
      '<p class="paynote">' + text + '</p>';
  }

  function renderPane() {
    const pane = U.$('#payPane');
    if (!pane) return;
    const { plan, value } = curPlan();
    if (plan.preview || value === 0) {
      pane.innerHTML = '<p class="paynote">' + t('plan.previewBlocked') + '</p>';
      return;
    }
    const amount = value === 0 ? t('common.free') : U.num(value, 'plain') + (QG.i18n.lang === 'ar' ? ' ج.م' : ' EGP');
    const ref = 'QG-' + (plan.id || '').toUpperCase();
    const pay = site().pay;

    if (method === 'vodafone') {
      pane.innerHTML =
        payerRow(t('pay.vf.number'), pay.vodafone.number, true) +
        payerRow(t('pay.vf.holder'), pay.vodafone.holder) +
        payerRow(t('pay.amount'), amount) +
        '<p class="paynote">' + t('pay.note.vf', { amount: amount, ref: ref }) + '</p>' +
        waRow(t('pay.waNote', { number: waPretty() }));
    } else if (method === 'instapay') {
      pane.innerHTML =
        payerRow(t('pay.ip.addr'), pay.instapay.handle, true) +
        payerRow(t('pay.ip.holder'), pay.instapay.holder) +
        payerRow(t('pay.amount'), amount) +
        '<p class="paynote">' + t('pay.note.ip', { handle: pay.instapay.handle, amount: amount }) + '</p>' +
        waRow(t('pay.waNote', { number: waPretty() }));
    } else {
      pane.innerHTML =
        payerRow(t('pay.vf.number'), pay.vodafone.number, true) +
        payerRow(t('pay.vf.holder'), pay.vodafone.holder) +
        payerRow(t('pay.amount'), amount) +
        '<p class="paynote">' + t('pay.note.vf', { amount: amount, ref: ref }) + '</p>' +
        waRow(t('pay.waNote', { number: waPretty() }));
    }

    U.$$('[data-copy]', pane).forEach(btn => {
      btn.addEventListener('click', e => {
        e.preventDefault();
        U.copy(btn.dataset.copy).then(ok => {
          U.toast(ok ? t('toast.copied') : t('toast.copyFail'), ok ? 'success' : 'error');
          if (ok) QG.sound.click(1.2);
        });
      });
    });
  }

  function updateCheckout() {
    const { plan, value } = curPlan();
    const preview = !!plan.preview || value === 0;
    const amt = U.$('#checkoutAmount');
    if (amt) amt.textContent = preview ? t('common.free') : U.num(value, 'plain') + ' EGP';
    U.$('#checkoutSummary').textContent = plan.name + ' · ' +
      (preview ? t('plan.previewNote') : st().period === 'yearly' ? t('common.perYear') : t('common.perMonth'));
    renderPane();
    const submit = U.$('#submitPayment');
    if (submit) {
      submit.textContent = preview ? t('plan.previewCta') : t('form.submit');
      submit.disabled = preview;
    }
  }

  /* -------------------------------------------------------------- receipt */
  function setReceipt(file) {
    if (!file) return;
    const okType = /^image\//.test(file.type) || file.type === 'application/pdf';
    if (!okType) { fail(t('err.type')); return; }
    if (file.size > 6 * 1024 * 1024) { fail(t('err.size')); return; }
    receipt = file;
    U.$('#dzIdle').hidden = true;
    U.$('#dzPreview').hidden = false;
    U.$('#dzName').textContent = file.name;
    U.$('#dzSize').textContent = (file.size / 1024).toFixed(0) + ' KB · ' + t('toast.receipt');
    const thumb = U.$('#dzThumb');
    if (/^image\//.test(file.type)) { thumb.src = URL.createObjectURL(file); thumb.hidden = false; }
    else { thumb.removeAttribute('src'); thumb.hidden = true; }
    QG.sound.success();
  }

  function clearReceipt() {
    receipt = null;
    U.$('#dzIdle').hidden = false;
    U.$('#dzPreview').hidden = true;
    const input = U.$('#receiptFile');
    if (input) input.value = '';
  }

  /* --------------------------------------------------------------- orders */
  function loadOrders() {
    st().orders = U.store.get(ORDER_KEY, []);
    return st().orders;
  }
  function saveOrders() { U.store.set(ORDER_KEY, st().orders); }

  function orderId() {
    const d = new Date();
    const stamp = String(d.getFullYear()).slice(2) + String(d.getMonth() + 1).padStart(2, '0') + String(d.getDate()).padStart(2, '0');
    return 'QG-' + stamp + '-' + String(1000 + Math.floor(Math.random() * 8999));
  }

  function renderOrders() {
    const wrap = U.$('#orders');
    if (!wrap) return;
    const me = QG.auth.session && QG.auth.session.email ? String(QG.auth.session.email).toLowerCase() : '';
    const admin = QG.auth.isAdmin();
    const list = admin ? st().orders
      : (me ? st().orders.filter(o => String(o.email || '').toLowerCase() === me) : []);
    if (!list.length) {
      wrap.innerHTML = '<p class="micro" style="text-align:start">' + t('order.none') + '</p>';
      return;
    }
    wrap.innerHTML = '';
    list.slice(0, 6).forEach(o => {
      const card = U.el('div', { class: 'order' });
      const tone = o.status === 'Active' ? 'ok' : o.status === 'Rejected' ? 'bad' : 'warn';
      const statusLabel = o.status === 'Active' ? t('order.active') : o.status === 'Rejected' ? t('order.rejected') : t('order.pending');
      card.innerHTML =
        '<div><div class="order__id">' + U.esc(o.id) + '</div>' +
        '<div class="order__meta"><b>' + U.esc(o.plan) + '</b> · ' + U.esc(o.period) + ' · ' + U.esc(o.method) + ' · ' +
        (o.amount === 0 ? t('common.free') : U.num(o.amount, 'plain') + ' EGP') + ' · ' + U.esc(o.date) + '</div>' +
        '<div class="order__meta">' + U.esc(o.email || '—') + '</div></div>' +
        '<div class="btn-row">' +
        '<a class="btn btn--wa btn--sm" href="' + waLink(o) + '" target="_blank" rel="noopener">' + t('order.wa') + '</a>' +
        (admin && o.status === 'Pending review' ? '<button class="btn btn--ghost btn--sm" data-approve="' + o.id + '">' + t('order.approve') + '</button>' : '') +
        '<span class="badge badge--' + tone + '">' + statusLabel + '</span>' +
        '</div>';
      wrap.appendChild(card);
    });
  }

  function approve(id) {
    if (!QG.auth.isAdmin()) { U.toast(QG.t('toast.adminOnly'), 'error'); QG.sound.error(); return; }
    const o = st().orders.find(x => x.id === id);
    if (!o) return;
    if (!o.email) { U.toast(t('order.noEmail'), 'error'); QG.sound.error(); return; }
    const sub = QG.access.grant(o.email, o.planId || o.plan, o.period);
    o.status = 'Active';
    saveOrders();
    renderOrders();
    if (QG.access) QG.access.update();
    U.toast((sub ? sub.plan : o.plan) + ' · ' + t('plan.paid'), 'success');
    QG.sound.success();
  }

  /* ---------------------------------------------------------- success card */
  function showSuccess(order) {
    const box = U.$('#receiptSuccess');
    if (!box) return;
    box.hidden = false;
    box.innerHTML =
      '<div class="success__check" aria-hidden="true">✓</div>' +
      '<div class="success__body">' +
      '<h3>' + t('order.received', { id: order.id }) + '</h3>' +
      '<p class="micro">' + t('pay.waAfter', { number: waPretty() }) + '</p>' +
      '</div>' +
      '<a class="btn btn--wa" href="' + waLink(order) + '" target="_blank" rel="noopener">' +
      '<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.1-1.3A10 10 0 1 0 12 2zm0 18a8 8 0 0 1-4.1-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8 8 0 1 1 12 20zm4.5-5.9c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.5.1l-.7.9c-.1.2-.3.2-.5.1a6.5 6.5 0 0 1-3.2-2.8c-.1-.2 0-.4.1-.5l.6-.7c.1-.2.1-.3 0-.5l-.7-1.7c-.1-.3-.3-.3-.5-.3h-.5c-.2 0-.5.1-.7.3-.7.7-.9 1.6-.7 2.6.4 1.9 1.8 3.6 3.6 4.5 1.5.8 2.6.8 3.3.7.5-.1.9-.5 1.1-.9.2-.4.2-.8.1-.9z"/></svg>' +
      t('pay.waSend') + '</a>';
    box.scrollIntoView({ behavior: 'smooth', block: 'center' });
    QG.sound.success();
  }

  /* ---------------------------------------------------------------- submit */
  function submit(e) {
    e.preventDefault();
    const { plan, value } = curPlan();

    if (plan.preview || value === 0) {
      U.toast(t('plan.previewBlocked'), 'error');
      QG.sound.error();
      return;
    }

    const who = QG.auth && QG.auth.session;
    if (!who || !who.email) {
      U.toast(t('pay.needSignIn'), 'error');
      QG.auth.openModal();
      return;
    }

    const name = U.$('#senderName').value.trim();
    const phone = U.$('#senderPhone').value.replace(/\s/g, '');
    const ref = U.$('#txRef').value.trim();
    const date = U.$('#txDate').value || U.fmtDate(new Date());
    const amount = Number(U.$('#txAmount').value) || value;
    const agree = U.$('#agree').checked;

    if (name.length < 2) { U.$('#senderName').focus(); return fail(t('err.name')); }
    if (!/^0?1[0-9]{9}$/.test(phone) && !/^\+?[0-9]{8,15}$/.test(phone)) { U.$('#senderPhone').focus(); return fail(t('err.phone')); }
    if (!receipt) { U.$('#dropzone').focus(); return fail(t('err.receipt')); }
    if (!agree) return fail(t('err.agree'));

    const btn = U.$('#submitPayment');
    btn.disabled = true;
    btn.textContent = t('form.sending');

    const order = {
      id: orderId(), plan: plan.name, planId: plan.id, period: st().period,
      amount, method: site().pay[method] ? site().pay[method].label : method,
      email: who.email.toLowerCase(),
      name, phone, ref, date,
      receipt: { name: receipt.name, size: receipt.size, type: receipt.type },
      status: 'Pending review', createdAt: new Date().toISOString()
    };

    setTimeout(() => {
      st().orders.unshift(order);
      saveOrders();
      renderOrders();
      showSuccess(order);
      clearReceipt();
      U.$('#receiptForm').reset();
      btn.disabled = false;
      btn.textContent = t('form.submit');
      if (QG.access) QG.access.update();
      U.toast(t('order.received', { id: order.id }), 'success');
      QG.sound.success();
    }, 900);
  }

  function fail(msg) { U.toast(msg, 'error'); QG.sound.error(); }

  /* ------------------------------------------------------------------ wire */
  function wire() {
    loadOrders();
    renderPlans();
    updateCheckout();
    renderOrders();

    U.$$('.plan-toggle__btn').forEach(btn => {
      btn.addEventListener('click', () => {
        U.$$('.plan-toggle__btn').forEach(b => b.classList.toggle('is-active', b === btn));
        st().period = btn.dataset.period;
        renderPlans(); updateCheckout();
        QG.sound.click();
      });
    });

    U.$$('.paytab').forEach(tab => {
      tab.addEventListener('click', () => {
        U.$$('.paytab').forEach(x => {
          x.classList.toggle('is-active', x === tab);
          x.setAttribute('aria-selected', x === tab ? 'true' : 'false');
        });
        method = tab.dataset.method;
        renderPane();
        QG.sound.click();
      });
    });

    const input = U.$('#receiptFile');
    const dz = U.$('#dropzone');
    if (input) input.addEventListener('change', () => setReceipt(input.files[0]));
    if (dz) {
      ['dragenter', 'dragover'].forEach(ev => dz.addEventListener(ev, e => { e.preventDefault(); dz.classList.add('is-over'); }));
      ['dragleave', 'drop'].forEach(ev => dz.addEventListener(ev, e => { e.preventDefault(); dz.classList.remove('is-over'); }));
      dz.addEventListener('drop', e => { if (e.dataTransfer.files[0]) setReceipt(e.dataTransfer.files[0]); });
      dz.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); input.click(); } });
    }

    document.addEventListener('click', e => {
      if (e.target.closest('[data-act="clear-receipt"]')) { e.preventDefault(); clearReceipt(); }
      const ap = e.target.closest('[data-approve]');
      if (ap) approve(ap.dataset.approve);
      if (e.target.closest('.btn--wa')) U.toast(t('toast.wa'));
    });

    const form = U.$('#receiptForm');
    if (form) form.addEventListener('submit', submit);
  }

  QG.payments = { wire, renderPlans, updateCheckout, loadOrders, renderOrders, waLink };
})(window.QG);

</script>
<script>
/* ---- admin.js ---- */
/* =============================================================================
   admin.js — owner-only panel: brand, payment rails, plan pricing, people.
   Members never see this panel; writes are guarded by QG.auth.isAdmin().
   ============================================================================= */
window.QG = window.QG || {};

(function (QG) {
  'use strict';

  const U = QG.util;
  const USERS = 'qg.users.v1';

  function open() {
    if (!QG.auth.isAdmin()) {
      U.toast(QG.t('toast.adminOnly'), 'error');
      QG.sound.error();
      return;
    }
    const p = U.$('#adminPanel');
    if (!p) return;
    render();
    p.hidden = false;
    p.classList.add('is-open');
    QG.sound.swoosh();
  }

  function close() {
    const p = U.$('#adminPanel');
    if (!p) return;
    p.classList.remove('is-open');
    setTimeout(() => { p.hidden = true; }, 220);
  }

  function field(id, label, value, type) {
    return '<div class="field"><label for="' + id + '">' + U.esc(label) + '</label>' +
      '<input id="' + id + '" type="' + (type || 'text') + '" value="' + U.esc(value == null ? '' : value) + '" /></div>';
  }

  function render() {
    const p = U.$('#adminPanel');
    if (!p) return;
    const s = QG.site.get();

    U.$('#adminBrand').innerHTML =
      field('adBrand', QG.t('admin.brandName'), s.brand) +
      field('adTagline', QG.t('admin.tagline'), s.tagline) +
      field('adSupport', QG.t('admin.support'), s.support) +
      field('adClient', 'Google OAuth Client ID', s.googleClientId);

    U.$('#adminPay').innerHTML =
      field('adVf', QG.t('admin.vf'), s.pay.vodafone.number) +
      field('adVfName', QG.t('admin.bankName'), s.pay.vodafone.holder) +
      field('adIp', QG.t('admin.ip'), s.pay.instapay.handle) +
      field('adIpName', QG.t('admin.bankName'), s.pay.instapay.holder) +
      field('adWa', QG.t('admin.wa'), s.whatsapp || '');

    U.$('#adminPlans').innerHTML = s.plans.map((pl, i) =>
      '<div class="adminplan">' +
      '<div class="field"><label>' + U.esc(pl.name) + '</label>' +
      '<input type="text" data-plan="' + i + '" data-k="name" value="' + U.esc(pl.name) + '" /></div>' +
      '<div class="field-row">' +
      '<div class="field"><label>Monthly</label><input type="number" min="0" data-plan="' + i + '" data-k="monthly" value="' + pl.monthly + '" /></div>' +
      '<div class="field"><label>Yearly</label><input type="number" min="0" data-plan="' + i + '" data-k="yearly" value="' + pl.yearly + '" /></div>' +
      '</div></div>').join('');

    const users = U.store.get(USERS, []);
    const subs = (QG.access ? QG.access.subscribers() : []);
    const plans = QG.site.get().plans.map(p => '<option value="' + U.esc(p.id) + '">' + U.esc(p.name) + '</option>').join('');

    U.$('#adminUsersList').innerHTML =
      '<div class="admingrant">' +
      '<div class="field"><label for="grantEmail">' + U.esc(QG.t('admin.grantEmail')) + '</label>' +
      '<input id="grantEmail" type="email" placeholder="name@gmail.com" /></div>' +
      '<div class="field-row">' +
      '<div class="field"><label for="grantPlan">' + U.esc(QG.t('admin.grantPlan')) + '</label>' +
      '<select id="grantPlan">' + plans + '</select></div>' +
      '<div class="field"><label for="grantMonths">' + U.esc(QG.t('admin.grantMonths')) + '</label>' +
      '<input id="grantMonths" type="number" min="1" max="24" value="1" /></div>' +
      '</div>' +
      '<button class="btn btn--primary btn--sm" data-act="grant-sub">' + U.esc(QG.t('admin.grantGo')) + '</button>' +
      '</div>' +
      '<p class="micro">' + U.esc(QG.t('admin.subs')) + '</p>' +
      (subs.length
        ? subs.map(su => '<div class="adminuser"><span>' + U.esc(su.email) + '</span>' +
          '<span class="adminuser__sub">' + U.esc(su.plan) + ' · ' + U.esc(QG.access.fmtDate(su.expiresAt)) + '</span>' +
          '<button class="btn btn--ghost btn--sm" data-revoke="' + U.esc(su.email) + '">' + U.esc(QG.t('admin.revoke')) + '</button></div>').join('')
        : '<p class="micro">—</p>') +
      '<p class="micro" style="margin-top:12px">' + U.esc(QG.t('admin.usersHint')) + '</p>' +
      (users.length
        ? users.map(u => '<div class="adminuser"><span>' + U.esc(u.email) + '</span>' +
          '<span class="badge badge--' + (u.role === 'admin' ? 'info' : '') + '">' + U.esc(u.role) + '</span>' +
          '<span class="adminuser__when">' + new Date(u.last).toLocaleDateString() + '</span></div>').join('')
        : '<p class="micro">—</p>');
  }

  function save() {
    if (!QG.auth.isAdmin()) { U.toast(QG.t('toast.adminOnly'), 'error'); return; }
    const val = id => { const n = U.$('#' + id); return n ? n.value.trim() : ''; };
    const plans = QG.site.get().plans.map((pl, i) => {
      const name = U.$('[data-plan="' + i + '"][data-k="name"]');
      const m = U.$('[data-plan="' + i + '"][data-k="monthly"]');
      const y = U.$('[data-plan="' + i + '"][data-k="yearly"]');
      return Object.assign({}, pl, {
        name: name ? name.value.trim() || pl.name : pl.name,
        monthly: m ? Number(m.value) || 0 : pl.monthly,
        yearly: y ? Number(y.value) || 0 : pl.yearly
      });
    });

    QG.site.patch({
      brand: val('adBrand') || QG.site.get().brand,
      tagline: val('adTagline'),
      support: val('adSupport'),
      googleClientId: val('adClient'),
      whatsapp: val('adWa') || QG.site.get().whatsapp,
      pay: {
        vodafone: { label: 'Vodafone Cash', number: val('adVf'), holder: val('adVfName') },
        instapay: { label: 'InstaPay', handle: val('adIp'), holder: val('adIpName') }
      },
      plans: plans
    });

    QG.payments.renderPlans();
    QG.payments.updateCheckout();
    QG.theme.apply();
    U.toast(QG.t('admin.saved'), 'success');
    QG.sound.success();
  }

  function wire() {
    const p = U.$('#adminPanel');
    if (!p) return;
    p.addEventListener('click', e => { if (e.target === p) close(); });
    document.addEventListener('click', e => {
      const a = e.target.closest('[data-act]');
      if (!a) return;
      if (a.dataset.act === 'open-admin') { e.preventDefault(); open(); }
      if (a.dataset.act === 'close-admin') { e.preventDefault(); close(); }
      if (a.dataset.act === 'save-admin') { e.preventDefault(); save(); }
      if (a.dataset.act === 'admin-default') { e.preventDefault(); QG.theme.saveAsDefault(); }
      if (a.dataset.act === 'grant-sub') {
        e.preventDefault();
        if (!QG.auth.isAdmin()) { U.toast(QG.t('toast.adminOnly'), 'error'); return; }
        const mailNode = U.$('#grantEmail');
        const planNode = U.$('#grantPlan');
        const monthsNode = U.$('#grantMonths');
        const mail = mailNode ? mailNode.value.trim() : '';
        const planId = planNode ? planNode.value : '';
        const months = monthsNode ? Number(monthsNode.value) || 1 : 1;
        if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(mail)) { U.toast(QG.t('admin.grantBad'), 'error'); QG.sound.error(); return; }
        QG.access.grant(mail, planId, 'monthly', months);
        render();
        U.toast(QG.t('admin.granted', { email: mail.toLowerCase() }), 'success');
        QG.sound.success();
      }
      if (a.dataset.act === 'admin-export') {
        e.preventDefault();
        U.download('quill-grid-site.json', JSON.stringify(QG.site.get(), null, 2), 'application/json');
        U.toast(QG.t('admin.saved'), 'success');
      }
    });
    p.addEventListener('click', e => {
      const r = e.target.closest('[data-revoke]');
      if (!r) return;
      e.preventDefault();
      if (!QG.auth.isAdmin()) { U.toast(QG.t('toast.adminOnly'), 'error'); return; }
      QG.access.revoke(r.dataset.revoke);
      render();
      U.toast(QG.t('admin.revoked'), 'success');
    });
    document.addEventListener('qg:auth', () => {
      const link = U.$('[data-act="open-admin"]');
      if (link) link.hidden = !QG.auth.isAdmin();
    });
  }

  QG.admin = { open, close, render, save, wire };
})(window.QG);

</script>
<script>
/* ---- access.js ---- */
/* =============================================================================
   access.js — one rule: a project can only be created by an account with access.
   Owner emails (CONFIG.ownerEmails) always have it; everybody else needs an
   active subscription, granted after a reviewed Vodafone Cash / InstaPay
   payment. Signed-out visitors can read the plans and nothing else.
   ============================================================================= */
window.QG = window.QG || {};

(function (QG) {
  'use strict';

  const U = QG.util;
  const SUBS = 'qg.subs.v1';
  const DAY = 86400000;
  const t = function (k, v) { return QG.t(k, v); };

  let view = 'excel';

  function subs() { return U.store.get(SUBS, {}); }
  function saveSubs(all) { U.store.set(SUBS, all); }

  function email() {
    const s = QG.auth ? QG.auth.session : null;
    return s && s.email ? String(s.email).toLowerCase() : '';
  }
  function isOwner() { return !!(QG.auth && QG.auth.isAdmin()); }
  function record(who) { return subs()[who || email()] || null; }

  function active(who) {
    const r = record(who);
    if (!r || r.status !== 'active') return null;
    if (r.expiresAt && r.expiresAt < Date.now()) return null;
    return r;
  }

  function hasAccess() { return isOwner() || !!active(); }
  function canCreate() { return !!email() && hasAccess(); }

  function planById(id) {
    const plans = (QG.site && QG.site.get().plans) || [];
    for (let i = 0; i < plans.length; i++) if (plans[i].id === id) return plans[i];
    return null;
  }

  function fmtDate(ts) {
    if (!ts) return '—';
    try {
      return new Date(ts).toLocaleDateString(QG.i18n.lang === 'ar' ? 'ar-EG' : 'en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
    } catch (e) { return ''; }
  }

  /* ------------------------------------------------------------ granting */
  function grant(who, planId, period, months) {
    const mail = String(who || '').toLowerCase().trim();
    if (!mail) return null;
    const plan = (planId && typeof planId === 'object')
      ? planId
      : (planById(planId) || { id: planId || 'plan', name: String(planId || 'Plan') });
    const per = period === 'yearly' ? 'yearly' : 'monthly';
    const conf = (QG.CONFIG && QG.CONFIG.access) || {};
    const days = months ? Math.round(Number(months) * 30)
      : (per === 'yearly' ? (conf.yearlyDays || 365) : (conf.monthlyDays || 30));
    const all = subs();
    const prev = all[mail];
    const from = prev && prev.expiresAt && prev.expiresAt > Date.now() ? prev.expiresAt : Date.now();
    all[mail] = {
      email: mail,
      planId: plan.id,
      plan: plan.name,
      period: per,
      status: 'active',
      startedAt: Date.now(),
      expiresAt: from + days * DAY
    };
    saveSubs(all);
    update();
    return all[mail];
  }

  function revoke(who) {
    const all = subs();
    delete all[String(who || '').toLowerCase().trim()];
    saveSubs(all);
    update();
  }

  function subscribers() {
    const all = subs();
    return Object.keys(all).map(function (k) { return all[k]; })
      .sort(function (a, b) { return (b.expiresAt || 0) - (a.expiresAt || 0); });
  }

  /* ----------------------------------------------------------------- pill */
  function paintPill() {
    const pill = U.$('#planPill');
    if (!pill) return;
    const mail = email();
    const sub = active();
    pill.classList.remove('pill--live', 'pill--warn');
    if (!mail) {
      pill.textContent = t('pill.signin');
      pill.classList.add('pill--warn');
    } else if (isOwner()) {
      pill.textContent = t('pill.owner');
      pill.classList.add('pill--live');
    } else if (sub) {
      pill.textContent = sub.plan + ' · ' + t('pill.until', { date: fmtDate(sub.expiresAt) });
      pill.classList.add('pill--live');
    } else {
      pill.textContent = t('pill.nosub');
      pill.classList.add('pill--warn');
    }
  }

  /* ----------------------------------------------------------------- gate */
  function update() {
    const locked = !canCreate();
    document.body.classList.toggle('is-locked', locked);
    paintPill();

    const g = U.$('#gate');
    if (!g) return;
    g.hidden = !locked || view === 'billing';
    if (!locked) return;

    const mail = email();
    const title = U.$('#gateTitle');
    const desc = U.$('#gateDesc');
    const who = U.$('#gateWho');
    const googleBtn = U.$('#gateGoogle');
    const planBtn = U.$('#gatePlan');
    const outBtn = U.$('#gateSignout');

    if (!mail) {
      if (title) title.textContent = t('gate.title.out');
      if (desc) desc.textContent = t('gate.desc.out');
      if (who) who.hidden = true;
      if (googleBtn) googleBtn.hidden = false;
      if (planBtn) planBtn.hidden = true;
      if (outBtn) outBtn.hidden = true;
    } else {
      if (title) title.textContent = t('gate.title.nosub');
      if (desc) desc.textContent = t('gate.desc.nosub');
      if (who) { who.hidden = false; who.textContent = mail; }
      if (googleBtn) googleBtn.hidden = true;
      if (planBtn) { planBtn.hidden = false; planBtn.classList.remove('btn--ghost'); planBtn.classList.add('btn--primary'); }
      if (outBtn) outBtn.hidden = false;
    }
  }

  function requireAccess() {
    if (canCreate()) return true;
    if (view === 'billing' && QG.app) QG.app.setView('excel');
    update();
    U.toast(t('gate.toast'), 'error');
    QG.sound.error();
    return false;
  }

  function onView(next) { view = next; update(); }

  /* ----------------------------------------------------------------- wire */
  function wire() {
    document.addEventListener('qg:auth', function () { update(); });
    document.addEventListener('click', function (e) {
      const a = e.target.closest('[data-act="gate-google"], [data-act="gate-plan"], [data-act="gate-signout"]');
      if (!a) return;
      e.preventDefault();
      const act = a.dataset.act;
      if (act === 'gate-google') QG.auth.openModal();
      else if (act === 'gate-plan' && QG.app) QG.app.setView('billing');
      else if (act === 'gate-signout') {
        if (window.confirm(QG.t('auth.signout') + '?')) QG.auth.signOut();
      }
    });
    update();
  }

  QG.access = {
    wire: wire, update: update, onView: onView, requireAccess: requireAccess,
    canCreate: canCreate, hasAccess: hasAccess, isOwner: isOwner,
    email: email, active: active, record: record, grant: grant, revoke: revoke,
    subscribers: subscribers, planById: planById, fmtDate: fmtDate,
    get view() { return view; }
  };
})(window.QG);

</script>
<script>
/* ---- app.js ---- */
/* =============================================================================
   app.js — boot, routing, design drawer, command palette, language, sound
   ============================================================================= */
window.QG = window.QG || {};

(function (QG) {
  'use strict';

  const U = QG.util;
  const t = (k, v) => QG.t(k, v);

  /* -------------------------------------------------------------- routing */
  let view = 'excel';

  function setView(next, silent) {
    const target = U.$('#view-' + next);
    if (!target) return;
    view = next;
    U.$$('.view').forEach(v => {
      const on = v === target;
      v.hidden = !on;
      v.classList.toggle('is-active', on);
    });
    U.$$('.dock [data-nav]').forEach(b => b.classList.toggle('is-active', b.dataset.nav === next));
    const sub = U.$('#viewSub');
    if (sub) sub.textContent = t('sub.' + next);
    if (QG.access) QG.access.onView(next);
    if (!silent) QG.sound.swoosh();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  /* --------------------------------------------------------------- drawer */
  function openDrawer() {
    if (QG.access && !QG.access.requireAccess()) return;
    U.$('#customizer').classList.add('is-open');
    U.$('#customizer').setAttribute('aria-hidden', 'false');
    U.$('#scrim').hidden = false;
    QG.theme.renderColumns();
    QG.sound.swoosh();
  }

  function closeDrawer() {
    U.$('#customizer').classList.remove('is-open');
    U.$('#customizer').setAttribute('aria-hidden', 'true');
    U.$('#scrim').hidden = true;
  }

  /* ---------------------------------------------------------------- sound */
  function wireSound() {
    const key = 'qg.sound';
    const saved = U.store.get(key, true);
    QG.sound.setEnabled(saved);
    const btn = U.$('[data-act="toggle-sound"]');
    const paint = () => { if (btn) btn.setAttribute('aria-pressed', QG.sound.enabled ? 'true' : 'false'); };
    paint();
    if (btn) btn.addEventListener('click', () => {
      const next = !QG.sound.enabled;
      QG.sound.setEnabled(next);
      U.store.set(key, next);
      paint();
      if (next) { QG.sound.click(1.2); U.toast(t('toast.soundOn')); }
      else U.toast(t('toast.soundOff'));
    });
  }

  /* --------------------------------------------------------------- ripple */
  function wireRipple() {
    document.addEventListener('pointerdown', e => {
      const node = e.target.closest('.btn, .chip, .paytab, .dock__btn, .plan, .hook, .swatch, .lang-btn');
      if (!node) return;
      const rect = node.getBoundingClientRect();
      const size = Math.max(rect.width, rect.height);
      const r = U.el('span', { class: 'ripple' });
      r.style.width = r.style.height = size + 'px';
      r.style.left = (e.clientX - rect.left - size / 2) + 'px';
      r.style.top = (e.clientY - rect.top - size / 2) + 'px';
      if (getComputedStyle(node).position === 'static') node.style.position = 'relative';
      if (getComputedStyle(node).overflow === 'visible') node.style.overflow = 'hidden';
      node.appendChild(r);
      setTimeout(() => r.remove(), 640);
    });
  }

  function wireClickSound() {
    document.addEventListener('pointerdown', e => {
      const node = e.target.closest('button, a, [role="tab"], .swatch, .hook, .dropzone');
      if (!node) return;
      if (node.matches('input[type="range"], input[type="checkbox"], select, input')) return;
      QG.sound.click(node.classList.contains('btn--primary') ? 1.15 : 1);
    }, { passive: true });

    document.addEventListener('pointerover', e => {
      const node = e.target.closest('.dock__btn, .chip');
      if (!node || node.contains(e.relatedTarget)) return;
      QG.sound.tick();
    }, { passive: true });
  }

  function wireGlow() {
    const glow = U.$('#cursorGlow');
    if (!glow || window.matchMedia('(pointer: coarse)').matches) return;
    let x = 0, y = 0, cx = 0, cy = 0, raf = null;
    document.addEventListener('pointermove', e => {
      x = e.clientX; y = e.clientY;
      glow.style.opacity = '0.5';
      if (!raf) raf = requestAnimationFrame(loop);
    }, { passive: true });
    function loop() {
      cx += (x - cx) * 0.12; cy += (y - cy) * 0.12;
      glow.style.transform = 'translate3d(' + (cx - 260) + 'px,' + (cy - 260) + 'px,0)';
      raf = (Math.abs(x - cx) > 0.5 || Math.abs(y - cy) > 0.5) ? requestAnimationFrame(loop) : null;
    }
  }

  /* ------------------------------------------------------------- commands */
  function cmds() {
    return [
      { label: t('cmdk.studio'), hint: '1', run: () => setView('excel') },
      { label: t('cmdk.script'), hint: '2', run: () => setView('script') },
      { label: t('cmdk.billing'), hint: '3', run: () => setView('billing') },
      { label: t('cmdk.design'), hint: 'D', run: openDrawer },
      { label: t('cmdk.lang'), hint: 'L', run: () => toggleLang() },
      { label: t('cmdk.shuffle'), hint: 'S', run: () => { closeCmdk(); QG.theme.shuffle(); } },
      { label: t('cmdk.xlsx'), hint: 'X', run: () => { closeCmdk(); QG.tableView.exportXLSX(); } },
      { label: t('cmdk.csv'), hint: 'C', run: () => { closeCmdk(); QG.tableView.exportCSV(); } },
      { label: t('cmdk.pdf'), hint: 'P', run: () => { closeCmdk(); QG.tableView.exportStyled(); } },
      { label: t('cmdk.copy'), hint: '⌘C', run: () => { closeCmdk(); U.$('[data-act="copy-script"]').click(); } },
      { label: t('cmdk.account'), hint: '@', run: () => { closeCmdk(); QG.auth.openModal(); } },
      { label: t('cmdk.admin'), hint: 'A', run: () => { closeCmdk(); QG.admin.open(); } },
      { label: t('cmdk.sound'), hint: 'M', run: () => { closeCmdk(); U.$('[data-act="toggle-sound"]').click(); } },
      { label: t('cmdk.reset'), hint: 'R', run: () => { closeCmdk(); QG.theme.reset(); } }
    ];
  }

  let cmdIndex = 0;
  let cmdkOpen = false;

  function openCmdk() {
    const box = U.$('#cmdk');
    box.hidden = false; cmdkOpen = true; cmdIndex = 0;
    const input = U.$('#cmdkInput');
    input.value = '';
    renderCmds('');
    setTimeout(() => input.focus(), 40);
    QG.sound.swoosh();
  }

  function closeCmdk() {
    const box = U.$('#cmdk');
    if (!box) return;
    box.hidden = true; cmdkOpen = false;
  }

  function renderCmds(query) {
    const list = U.$('#cmdkList');
    const q = String(query || '').toLowerCase().trim();
    const all = cmds();
    const items = all.filter(c => !q || (c.label + ' ' + c.hint).toLowerCase().indexOf(q) > -1);
    cmdIndex = U.clamp(cmdIndex, 0, Math.max(0, items.length - 1));
    list.innerHTML = items.length
      ? items.map((c, i) => '<button class="cmdk__item' + (i === cmdIndex ? ' is-sel' : '') + '" data-i="' + i + '">' +
        '<span>' + U.esc(c.label) + '</span><kbd>' + U.esc(c.hint) + '</kbd></button>').join('')
      : '<p class="micro" style="padding:12px">' + t('cmdk.none') + '</p>';
    U.$$('.cmdk__item', list).forEach(b => {
      b.addEventListener('click', () => { const c = items[+b.dataset.i]; closeCmdk(); c.run(); });
    });
    list._items = items;
  }

  function wireCmdk() {
    const box = U.$('#cmdk');
    const input = U.$('#cmdkInput');
    if (!box) return;
    input.addEventListener('input', () => { cmdIndex = 0; renderCmds(input.value); });
    input.addEventListener('keydown', e => {
      const items = U.$('#cmdkList')._items || [];
      if (e.key === 'ArrowDown') { e.preventDefault(); cmdIndex = Math.min(items.length - 1, cmdIndex + 1); renderCmds(input.value); QG.sound.tick(); }
      if (e.key === 'ArrowUp') { e.preventDefault(); cmdIndex = Math.max(0, cmdIndex - 1); renderCmds(input.value); QG.sound.tick(); }
      if (e.key === 'Enter') { e.preventDefault(); const c = items[cmdIndex]; if (c) { closeCmdk(); c.run(); } }
      if (e.key === 'Escape') closeCmdk();
    });
    box.addEventListener('click', e => { if (e.target === box) closeCmdk(); });

    document.addEventListener('keydown', e => {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        cmdkOpen ? closeCmdk() : openCmdk();
      }
      if (e.key === 'Escape') {
        if (cmdkOpen) closeCmdk();
        else if (U.$('#customizer').classList.contains('is-open')) closeDrawer();
      }
    });
  }

  /* -------------------------------------------------------------- language */
  function toggleLang() {
    const next = QG.i18n.lang === 'ar' ? 'en' : 'ar';
    QG.i18n.set(next);
    U.toast(t('toast.lang', { lang: next === 'ar' ? 'العربية' : 'English' }));
    QG.sound.click(1.1);
  }

  /* ------------------------------------------------------------------- nav */
  function wireNav() {
    document.addEventListener('click', e => {
      const n = e.target.closest('[data-nav]');
      if (n) { e.preventDefault(); setView(n.dataset.nav); }

      const a = e.target.closest('[data-act]');
      if (!a) return;
      const act = a.dataset.act;
      if (act === 'open-customizer') { e.preventDefault(); openDrawer(); }
      if (act === 'close-customizer') { e.preventDefault(); closeDrawer(); }
      if (act === 'palette') { e.preventDefault(); openCmdk(); }
      if (act === 'toggle-lang') { e.preventDefault(); toggleLang(); }
      if (act === 'reset-theme') { e.preventDefault(); QG.theme.reset(); }
      if (act === 'export-theme') {
        e.preventDefault();
        U.download('quill-grid-theme.json', JSON.stringify(QG.theme.get(), null, 2), 'application/json');
        U.toast(t('toast.theme'), 'success');
      }
    });
    const scrim = U.$('#scrim');
    if (scrim) scrim.addEventListener('click', closeDrawer);
  }

  /* ------------------------------------------------------------------ boot */
  function boot() {
    QG.i18n.init();
    QG.theme.apply(true);
    QG.theme.wire();
    QG.auth.wire();
    QG.access.wire();
    QG.admin.wire();
    QG.tableView.wire();
    QG.scriptView.wire();
    QG.payments.wire();
    wireNav();
    wireSound();
    wireRipple();
    wireClickSound();
    wireGlow();
    wireCmdk();

    const hash = (location.hash || '').replace('#', '');
    if (['excel', 'script', 'billing'].indexOf(hash) > -1) setView(hash, true);
    else setView('excel', true);

    /* second pass so every dynamic string is in the chosen language */
    QG.i18n.set(QG.i18n.lang, { silent: true });

    U.$$('.composer__input').forEach(n => { n.style.height = 'auto'; });

    if (QG.access) QG.access.update();

    /* admin fast path: /?admin or #admin */
    if (QG.auth.isAdmin() && (hash === 'admin')) QG.admin.open();
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
  else boot();

  QG.app = { setView, openDrawer, closeDrawer, openCmdk, toggleLang };
})(window.QG);

</script>
