/* ---- site.js ---- */
/* =============================================================================
   site.js — site-wide settings (brand, payment rails, plans).
   Only the owner account may write here; members never see these controls.
   ============================================================================= */
window.QG = window.QG || {};

(function (QG) {
  'use strict';

  const U = QG.util;
  const KEY = 'qg.site.v2';
  const C = QG.CONFIG;

  const base = {
    brand: 'Quill & Grid',
    tagline: 'Studio for the operator desk',
    support: C.supportEmail,
    googleClientId: C.googleClientId || '',
    whatsapp: '201016946303',
    pay: {
      vodafone: { label: 'Vodafone Cash', number: '01016946303', holder: 'Quill & Grid Studio' },
      instapay: { label: 'InstaPay', handle: 'quillgrid@instapay', holder: 'Quill & Grid Studio' }
    },
    plans: JSON.parse(JSON.stringify(C.plans))
  };

  function deepMerge(a, b) {
    if (!b || typeof b !== 'object') return a;
    const out = Array.isArray(a) ? a.slice() : Object.assign({}, a);
    Object.keys(b).forEach(k => {
      const v = b[k];
      if (v && typeof v === 'object' && !Array.isArray(v) && a && typeof a[k] === 'object') out[k] = deepMerge(a[k], v);
      else if (v !== undefined) out[k] = v;
    });
    return out;
  }

  let data = deepMerge(base, U.store.get(KEY, {}));

  /* migration: bank transfer is gone — drop any account stored for it */
  if (data.pay && data.pay.bank) {
    delete data.pay.bank;
    U.store.set(KEY, data);
  }

  function get() { return data; }

  function patch(next) {
    if (!QG.auth || !QG.auth.isAdmin()) {
      U.toast(QG.t('toast.adminOnly'), 'error');
      return data;
    }
    data = deepMerge(data, next);
    U.store.set(KEY, data);
    return data;
  }

  function reset() {
    if (!QG.auth || !QG.auth.isAdmin()) return data;
    data = JSON.parse(JSON.stringify(base));
    U.store.set(KEY, data);
    return data;
  }

  QG.site = { get, patch, reset, base };
})(window.QG);

