  .dock {
    left: 10px; right: 10px; top: auto; bottom: 10px; width: auto; height: 62px;
    flex-direction: row; justify-content: space-between; padding: 8px 10px; border-radius: 18px;
  }
  .dock__brand { margin: 0; width: 40px; height: 40px; }
  .dock__group, .dock__foot { flex-direction: row; gap: 4px; flex: 0 0 auto; }
  .dock__btn { width: 40px; height: 40px; }
  .dock__btn.is-active::before { display: none; }
