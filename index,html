      r.dataset.header = t.headerStyle || 'fill';
      r.dataset.borders = t.borders || 'rows';
      r.dataset.zebra = t.zebra ? 'on' : 'off';
      r.dataset.motion = t.motion === false ? 'off' : 'on';
