html[dir="rtl"] .cmdk__input { text-align: right; }
html[dir="rtl"] .field input, html[dir="rtl"] .field select { text-align: right; }
html[dir="rtl"] .payrow__v { flex-direction: row-reverse; }

@media (max-width: 860px) {
