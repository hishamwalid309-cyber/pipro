      ['3–7s', 'Tension', 'Most {topic}s get this wrong — they promise {promise}.', 'the real problem', 1],
      ['7–12s', 'Reveal', 'So this one is built around {benefit}.', 'BENEFIT', 2],
      ['12–15s', 'CTA', '{cta}', 'CTA', 5]
    ],
    30: [
      ['0–3s', 'Hook', '{hookLine}', 'HOOK TEXT', 0],
      ['3–8s', 'Tension', 'Most {topic}s fail in week one: wrong build, wrong promise, wrong price.', 'the actual problem', 1],
      ['8–14s', 'Reveal', 'This one is built around {benefit} — nothing decorative.', 'BENEFIT', 2],
      ['14–21s', 'Proof', 'Tested for [X] weeks. [One result you can repeat out loud.]', 'PROOF', 4],
      ['21–26s', 'Offer', 'This week it ships with {offer}.', 'THIS WEEK ONLY', 5],
      ['26–30s', 'CTA', '{cta}', 'CTA', 7]
    ],
    45: [
      ['0–3s', 'Hook', '{hookLine}', 'HOOK TEXT', 0],
      ['3–9s', 'Tension', 'You have bought a {topic} before. It ended up in a drawer — be honest.', 'the drawer problem', 1],
      ['9–16s', 'Reveal', 'Here is what changed: {benefit}.', 'WHAT CHANGED', 2],
      ['16–24s', 'Detail', 'Three details worth the money: the material, the fit, and the part that breaks first on cheaper ones.', 'DETAIL 1 · 2 · 3', 6],
      ['24–32s', 'Proof', 'Tested for [X] weeks — [result]. No fine print, no exceptions.', 'PROOF', 4],
      ['32–39s', 'Offer', 'This week: {offer}.', 'THE OFFER', 5],
      ['39–45s', 'CTA', '{cta}', 'CTA', 7]
    ],
    60: [
      ['0–4s', 'Hook', '{hookLine}', 'HOOK TEXT', 0],
      ['4–11s', 'Tension', 'Here is the pattern with every {topic} you have owned: it solves the first week and quits by the fourth.', 'week one vs week four', 1],
      ['11–19s', 'Reveal', 'The fix is boring — {benefit}.', 'THE FIX', 2],
      ['19–29s', 'Detail', 'Material, tolerance, and the one component everyone skips. That is where the price goes.', 'WHERE THE MONEY GOES', 6],
      ['29–39s', 'Proof', 'Tested for [X] weeks, [Y] uses. Here is the wear, unfiltered.', 'PROOF', 4],
      ['39–49s', 'Contrast', 'Cheaper option on the left. This one on the right. Same week of use.', 'SIDE BY SIDE', 3],
      ['49–55s', 'Offer', 'This week it ships with {offer}.', 'THE OFFER', 5],
      ['55–60s', 'CTA', '{cta}', 'CTA', 7]
    ]
  };

  /* ------------------------------------------------------------------ parse */
  function parse(text) {
    const raw = String(text || '').trim();
    const low = raw.toLowerCase();

    let platform = 'tiktok';
    if (/(reels?|instagram|insta)/.test(low)) platform = 'reels';
    else if (/shorts?/.test(low)) platform = 'shorts';
    else if (/youtube|\byt\b/.test(low)) platform = 'youtube';

    let seconds = 30;
    const d = low.match(/(\d{1,2})\s*(-|to\s*)?(\d{1,2})?\s*(s\b|sec|seconds|ثانية|ثواني)/);
    if (d) seconds = U.clamp(parseInt(d[1], 10), 10, 60);
    if (/minute|دقيقة/.test(low)) seconds = 60;
    const allowed = [15, 30, 45, 60];
    seconds = allowed.reduce((a, b) => Math.abs(b - seconds) < Math.abs(a - seconds) ? b : a, 60);

    let tone = 'calm';
    if (/(luxur|premium|elegant|فخم|راقي)/.test(low)) tone = 'luxury';
    else if (/(funny|playful|humou?r|fun\b|مرح|كوميدي)/.test(low)) tone = 'playful';
    else if (/(energetic|hype|fast|punchy|حماس|سريع)/.test(low)) tone = 'energetic';
    else if (/(bold|direct|blunt|جريء)/.test(low)) tone = 'bold';
    else if (/(story|emotional|personal|حكاية|قصص)/.test(low)) tone = 'story';
    else if (/(expert|professional|calm|clean|minimal|هادئ|احترافي)/.test(low)) tone = 'calm';

    let topic = raw
      .replace(/\b(write|make|generate|create|a|an|the|script|video|ad|advert|reel|reels|tiktok|shorts|youtube|for|about|on|vibe|tone|style|of|in|with)\b/gi, ' ')
      .replace(/\b\d{1,2}\s*(s|sec|secs|seconds?)\b/gi, ' ')
      .replace(/\b(luxury|premium|elegant|funny|playful|humou?r|energetic|hype|bold|direct|story|emotional|expert|professional|calm|clean|minimal)\b/gi, ' ')
      .replace(/[,.;:]+/g, ' ')
      .replace(/\s+/g, ' ')
      .trim();

    if (!topic) topic = 'this product';
    topic = topic.split(' ').slice(0, 6).join(' ').toLowerCase();

    return { raw, topic, platform, seconds, tone };
  }

  /* --------------------------------------------------------------- generate */
  function generate(text, bump) {
    const p = parse(text);
    const rand = U.rng(U.hash(p.raw.toLowerCase()) + (bump || 0) * 104729);
    const hookBank = HOOKS[p.tone] || HOOKS.calm;
    const hooks = [];
    const pool = hookBank.slice();
    for (let i = 0; i < 3 && pool.length; i++) {
      const idx = Math.floor(rand() * pool.length);
      hooks.push(pool.splice(idx, 1)[0].replace(/\{topic\}/g, p.topic));
    }
    const hookLine = hooks[0];
    const benefit = U.pick(rand, BENEFITS);
    const offer = U.pick(rand, OFFERS);
    const cta = U.pick(rand, CTAS);
    const promise = U.pick(rand, ['quality', 'speed', 'comfort', 'results', 'a feeling']);

    const plan = PLANS[p.seconds] || PLANS[30];
    const beats = plan.map((b, i) => {
      const vo = b[2]
        .replace(/\{hookLine\}/g, hookLine)
        .replace(/\{topic\}/g, p.topic)
        .replace(/\{benefit\}/g, benefit)
        .replace(/\{offer\}/g, offer)
        .replace(/\{cta\}/g, cta)
        .replace(/\{promise\}/g, promise);
      return {
        span: b[0], name: b[1], vo,
        on: b[3], broll: BROLL[b[4] % BROLL.length],
        sound: i === 0 ? 'Low sub hit on cut · no music in the first second'
          : i % 3 === 0 ? 'Layer a soft riser into the cut' : 'Keep the bed at −18 dB'
      };
    });

    const tags = ['#' + p.topic.replace(/[^a-z0-9]+/gi, ''), '#' + p.platform, '#smallbusiness',
      '#behindthescenes', '#' + (p.tone === 'luxury' ? 'quietluxury' : p.tone === 'playful' ? 'relatable' : 'howto')];

    return {
      ...p,
      platformName: PLATFORMS[p.platform].name,
      platformNote: PLATFORMS[p.platform].note,
      ratio: PLATFORMS[p.platform].ratio,
      toneName: TONES[p.tone].name,
      hooks, beats,
      hookLine, cta, offer, benefit,
      caption: hookLine.replace(/\.$/, '') + ' — ' + benefit + '. ' + cta,
      hashtags: tags,
      thumbnail: 'Freeze frame at 00:0' + (p.seconds > 30 ? '9' : '7') + ' — product fills 60% of frame, one line of text, nothing else.',
      notes: [
        'Shoot vertical at 1080×1920, 30 fps; keep the product in the top third so captions do not cover it.',
        'Burned-in captions: 3–5 words per line, safe margin 12% from the bottom.',
        'Cut every beat on the word, not on the breath — the first cut must land before 1.2s.',
        PLATFORMS[p.platform].note
      ]
    };
  }

  QG.ScriptEngine = { generate, parse, TONES, PLATFORMS };
})(window.QG);

</script>
<script>
/* ---- script-view.js ---- */
/* =============================================================================
   script-view.js — the script room: chat, staged generation, cut sheet, export
   ============================================================================= */
window.QG = window.QG || {};

(function (QG) {
  'use strict';

  const U = QG.util;
  let busy = false;

  /* ------------------------------------------------------------------ chat */
  function bubble(role, html) {
    const chat = U.$('#scriptChat');
    const msg = U.el('div', { class: 'msg msg--' + role });
    msg.innerHTML =
      '<div class="msg__avatar">' + (role === 'ai'
        ? '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 20c0-5 3-9 9-15 3 3 5 7 5 11a6 6 0 0 1-6 6H4z"/></svg>'
        : '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="8" r="3.4"/><path d="M5 20c1.5-3.5 4-5 7-5s5.5 1.5 7 5"/></svg>') + '</div>' +
      '<div class="msg__body"><span class="msg__meta">' + (role === 'ai' ? 'Studio' : 'You') + '</span><div class="bubble">' + html + '</div></div>';
    chat.appendChild(msg);
    chat.scrollTop = chat.scrollHeight + 200;
  }

  function typing() {
    const chat = U.$('#scriptChat');
    const msg = U.el('div', { class: 'msg msg--ai', id: 'scriptTyping' });
    msg.innerHTML = '<div class="msg__avatar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 20c0-5 3-9 9-15 3 3 5 7 5 11a6 6 0 0 1-6 6H4z"/></svg></div>' +
      '<div class="msg__body"><span class="msg__meta">Studio</span><div class="bubble"><span class="typing"><i></i><i></i><i></i></span></div></div>';
    chat.appendChild(msg);
    chat.scrollTop = chat.scrollHeight;
  }

  function endTyping() { const n = U.$('#scriptTyping'); if (n) n.remove(); }

  /* ---------------------------------------------------------------- render */
  function render() {
    const stage = U.$('#scriptStage');
    const s = QG.state.script;
    if (!stage || !s) return;

    const hooksHtml = s.hooks.map((h, i) =>
      '<button class="hook' + (h === s.hookLine ? ' is-pick' : '') + '" data-hook="' + i + '">' +
      '<b>' + (i + 1) + '</b><span>' + U.esc(h) + '</span></button>').join('');

    const beatsHtml = s.beats.map(b => `
      <div class="beat">
        <div class="beat__t">${U.esc(b.span)}</div>
        <div>
          <div class="beat__name">${U.esc(b.name)}</div>
          <div class="beat__vo">${U.esc(b.vo)}</div>
          <div class="beat__meta">
            <span><b>On screen</b> ${U.esc(b.on)}</span>
            <span><b>B-roll</b> ${U.esc(b.broll)}</span>
            <span><b>Sound</b> ${U.esc(b.sound)}</span>
          </div>
        </div>
      </div>`).join('');

    stage.innerHTML = `
      <div class="doc">
        <div class="doc__head">
          <div>
            <div class="eyebrow" style="margin-bottom:4px">${U.esc(s.platformName)} · ${s.seconds}s · ${U.esc(s.ratio)}</div>
            <h3 class="doc__topic">${U.esc(s.topic.replace(/\b\w/g, c => c.toUpperCase()))}</h3>
          </div>
          <div class="doc__tags">
            <span class="badge badge--info">${U.esc(s.toneName)}</span>
            <span class="badge">${s.beats.length} beats</span>
            <span class="badge badge--ok">Hook first</span>
          </div>
        </div>

        <div class="doc__section">
          <div class="doc__label">Hook options — tap to lock one in</div>
          <div class="hooks">${hooksHtml}</div>
        </div>

        <div class="doc__section">
          <div class="doc__label">Timed script</div>
          <div class="beats">${beatsHtml}</div>
        </div>

        <div class="doc__section">
          <div class="doc__label">Call to action</div>
          <div class="doc__cta"><b>${U.esc(s.cta)}</b><br/><span style="color:var(--muted);font-size:11.5px">Offer to pair with it: ${U.esc(s.offer)}</span></div>
        </div>

        <div class="doc__section">
          <div class="doc__label">Caption + tags</div>
          <p class="doc__caption">${U.esc(s.caption)}</p>
          <div class="doc__hash">${s.hashtags.map(t => '<span>' + U.esc(t) + '</span>').join('')}</div>
        </div>

        <div class="doc__section">
          <div class="doc__label">Shoot notes</div>
          <ul class="doc__caption" style="padding-left:16px;display:flex;flex-direction:column;gap:5px">
            ${s.notes.map(n => '<li>' + U.esc(n) + '</li>').join('')}
            <li>${U.esc(s.thumbnail)}</li>
          </ul>
        </div>
      </div>`;

    U.$('#scriptHeading').textContent = 'Script sheet';
    U.$('#scriptMeta').textContent = s.seconds + 's · ' + s.platformName + ' · ' + s.toneName + ' tone';
  }

  /* -------------------------------------------------------------- export */
  function asText(s) {
    const lines = [];
    lines.push(s.topic.toUpperCase() + ' — ' + s.seconds + 's ' + s.platformName + ' script');
    lines.push('Tone: ' + s.toneName + ' · Format: ' + s.ratio);
    lines.push('');
    lines.push('HOOK OPTIONS');
    s.hooks.forEach((h, i) => lines.push((i + 1) + '. ' + h));
    lines.push('');
    lines.push('TIMED SCRIPT');
    s.beats.forEach(b => {
      lines.push('[' + b.span + '] ' + b.name.toUpperCase());
      lines.push('  VO: ' + b.vo);
      lines.push('  ON SCREEN: ' + b.on);
      lines.push('  B-ROLL: ' + b.broll);
      lines.push('  SOUND: ' + b.sound);
      lines.push('');
    });
    lines.push('CTA: ' + s.cta);
    lines.push('OFFER: ' + s.offer);
    lines.push('');
    lines.push('CAPTION: ' + s.caption);
    lines.push('HASHTAGS: ' + s.hashtags.join(' '));
    lines.push('');
    lines.push('SHOOT NOTES');
    s.notes.forEach(n => lines.push('- ' + n));
    lines.push('- ' + s.thumbnail);
    return lines.join('\n');
  }

  function copyScript() {
    const s = QG.state.script;
    if (!s) return U.toast('Write a script first.', 'error');
    U.copy(asText(s)).then(ok => {
      U.toast(ok ? 'Script copied to clipboard.' : 'Copy blocked — use Download instead.', ok ? 'success' : 'error');
      if (ok) QG.sound.click(1.2);
    });
  }

  function downloadScript() {
    const s = QG.state.script;
    if (!s) return U.toast('Write a script first.', 'error');
    U.download(U.slug(s.topic) + '-script.md', asText(s), 'text/markdown;charset=utf-8');
    U.toast('Markdown script downloaded.', 'success');
    QG.sound.success();
  }

  /* ------------------------------------------------------------- pipeline */
  function looksLikeModifier(text) {
    return /(funnier|faster|slower|shorter|longer|more (funny|energetic|calm|luxur\w*|bold)|make it|another|new hook|reroll|again|version|seconds?|sec\b|tone|platform|tiktok|reels|shorts|youtube)/i.test(text);
  }

  function briefFrom(script, text) {
    const low = text.toLowerCase();
    let tone = script.tone;
    if (/(luxur|premium|elegant)/.test(low)) tone = 'luxury';
    else if (/(funny|playful|humor)/.test(low)) tone = 'playful';
    else if (/(energetic|hype|faster|punchy)/.test(low)) tone = 'energetic';
    else if (/(bold|direct|blunt)/.test(low)) tone = 'bold';
    else if (/(story|emotional|personal)/.test(low)) tone = 'story';
    else if (/(calm|expert|professional|calmer|shorter|slower)/.test(low)) tone = 'calm';

    let seconds = script.seconds;
    const d = low.match(/(\d{1,2})\s*(s|sec|seconds)/);
    if (d) seconds = U.clamp(parseInt(d[1], 10), 10, 60);
    if (/shorter/.test(low)) seconds = Math.max(15, seconds - 15);
    if (/longer/.test(low)) seconds = Math.min(60, seconds + 15);

    let platform = script.platform;
    if (/reels|instagram|insta/.test(low)) platform = 'reels';
    else if (/shorts/.test(low)) platform = 'shorts';
    else if (/youtube/.test(low)) platform = 'youtube';
    else if (/tiktok/.test(low)) platform = 'tiktok';

    return script.topic + ', ' + tone + ' tone, ' + seconds + ' seconds, ' + platform;
  }

  async function submit(text) {
    const prompt = String(text || '').trim();
    if (!prompt || busy) return;
    if (QG.access && !QG.access.requireAccess()) return;
    busy = true;
    const btn = U.$('#scriptSend');
    if (btn) btn.disabled = true;

    bubble('me', U.esc(prompt));
    const input = U.$('#scriptInput');
    input.value = '';
    input.style.height = 'auto';

    const existing = QG.state.script;
    let bump = 0;
    let brief = prompt;

    if (existing && looksLikeModifier(prompt) && prompt.split(' ').length <= 8) {
      if (/another|new hook|reroll|again/.test(prompt.toLowerCase())) bump = Date.now() % 997;
      brief = briefFrom(existing, prompt);
    }

    QG.sound.click();
    typing();
    U.$('#scriptStage').innerHTML =
      '<div class="skel-table" style="padding-top:14px">' +
      '<div class="r h"><div style="flex:2"></div><div></div></div>' +
      '<div class="r"><div style="flex:2"></div><div></div></div>'.repeat(3) +
      '<div style="height:1px;background:var(--line);margin:10px 0"></div>' +
      '<div class="r"><div style="flex:.4"></div><div style="flex:2"></div></div>'.repeat(4) +
      '</div>';

    await QG.job.run({
      ms: 5000,
      steps: ['Reading the brief', 'Picking the angle', 'Writing hooks that stop the scroll', 'Timing the beats to the cut', 'Tightening the CTA']
    });
    endTyping();

    const script = QG.ScriptEngine.generate(brief, bump);
    QG.state.script = script;
    render();
    QG.sound.success();

    const isMod = existing && brief !== prompt;
    bubble('ai',
      (isMod ? 'Reworked it — ' : 'Wrote a ') + '<b>' + script.seconds + 's ' + script.platformName + '</b> script for “' +
      U.esc(script.topic) + '” in a ' + script.toneName.toLowerCase() + ' tone.' +
      '<div class="bubble__hint">Three hooks, ' + script.beats.length + ' timed beats, caption and shoot notes. Tap a hook to swap it in.</div>' +
      '<div class="bubble__chips">' +
      '<button data-sfollow="funnier">funnier</button>' +
      '<button data-sfollow="15 seconds">15s cut</button>' +
      '<button data-sfollow="more luxury">more luxury</button>' +
      '<button data-sfollow="another version">reroll</button>' +
      '</div>');

    busy = false;
    if (btn) btn.disabled = false;
    input.focus();
  }

  function wire() {
    const form = U.$('#scriptForm');
    const input = U.$('#scriptInput');
    if (form) form.addEventListener('submit', e => { e.preventDefault(); submit(input.value); });
    if (input) {
      input.addEventListener('input', () => {
        input.style.height = 'auto';
        input.style.height = Math.min(120, input.scrollHeight) + 'px';
      });
      input.addEventListener('keydown', e => {
        if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); submit(input.value); }
      });
    }
    U.$$('#scriptChips .chip').forEach(c => {
      c.addEventListener('click', () => { input.value = c.dataset.prompt; submit(c.dataset.prompt); });
    });
    document.addEventListener('click', e => {
      const f = e.target.closest('[data-sfollow]');
      if (f && f.closest('#scriptChat')) submit(f.dataset.sfollow);

      const hook = e.target.closest('[data-hook]');
      if (hook && QG.state.script) {
        const idx = +hook.dataset.hook;
        const s = QG.state.script;
        const old = s.hookLine;
        s.hookLine = s.hooks[idx];
        s.beats.forEach(b => { b.vo = b.vo.split(old).join(s.hookLine); });
        s.caption = s.hookLine.replace(/\.$/, '') + ' — ' + s.benefit + '. ' + s.cta;
        render();
        QG.sound.click(1.15);
      }
    });

    const dice = U.$('[data-act="script-dice"]');
    if (dice) dice.addEventListener('click', () => {
      const ideas = [
        'Handmade leather wallet, luxury tone, 30 seconds',
        'Cold brew subscription, energetic, 15 seconds',
        'Skincare serum for oily skin, playful, 30 seconds',
        'Online accounting course, calm expert, 45 seconds',
        'Ceramic mug for offices, story tone, 30 seconds',
        'Delivery app for small shops, bold, 15 seconds'
      ];
      input.value = ideas[Math.floor(Math.random() * ideas.length)];
      QG.sound.tick();
      submit(input.value);
    });

    const copyBtn = U.$('[data-act="copy-script"]');
    if (copyBtn) copyBtn.addEventListener('click', copyScript);
    const dlBtn = U.$('[data-act="download-script"]');
    if (dlBtn) dlBtn.addEventListener('click', downloadScript);
  }

  QG.scriptView = { wire, render, submit };
})(window.QG);

</script>
