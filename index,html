/* -------------------------------------------------------------- WhatsApp */
.btn--wa {
  background: #1faa53; color: #fff; border-color: transparent;
  box-shadow: 0 12px 26px -16px rgba(31, 170, 83, 0.9);
}
.btn--wa:hover { background: #189146; transform: translateY(-1px); }
.payrow--wa { text-decoration: none; border-color: rgba(31, 170, 83, 0.35); background: rgba(31, 170, 83, 0.07); }
