  .wordmark__sub { display: none; }
  .palette-dots { display: none; }
  .panel__title { font-size: 24px; }
  .sheet__stamp { display: none; }
  .beat { grid-template-columns: 52px 1fr; gap: 8px; }
}
@media (max-width: 560px) {
  .topbar__right .pill { display: none; }
  .composer { padding: 8px 12px 14px; }
  .chat { padding: 2px 14px 8px; }
  .panel__head { padding: 16px 14px 10px; }
  .preview-area { padding: 2px 12px 14px; }
  .field-row { flex-direction: column; }
  .toasts { left: 12px; right: 12px; align-items: stretch; }
  .toast { max-width: none; }
  .btn--send span { display: none; }
}

html[data-motion="off"] *, html[data-motion="off"] *::before, html[data-motion="off"] *::after {
  animation-duration: 0.001ms !important; animation-iteration-count: 1 !important; transition-duration: 0.001ms !important;
}
@media (prefers-reduced-motion: reduce) {
  * { animation-duration: 0.001ms !important; transition-duration: 0.001ms !important; }
}

/* print: only the sheet */
