      'cmdk.design': 'تصميم المشروع', 'cmdk.shuffle': 'غيّر الاستايل عشوائيًا',
      'cmdk.xlsx': 'تصدير .xlsx', 'cmdk.csv': 'تصدير .csv', 'cmdk.pdf': 'ورقة PDF منسقة',
      'cmdk.copy': 'نسخ السكربت', 'cmdk.sound': 'تشغيل/كتم الصوت', 'cmdk.reset': 'استعادة التصميم',
      'cmdk.lang': 'تغيير اللغة (EN / AR)', 'cmdk.account': 'الحساب وتسجيل الدخول', 'cmdk.admin': 'إعدادات الموقع'
    }
  };

  let lang = 'en';

  function t(key, vars) {
    const pack = DICT[lang] || DICT.en;
    let out = pack[key] != null ? pack[key] : (DICT.en[key] != null ? DICT.en[key] : key);
    if (vars) Object.keys(vars).forEach(k => { out = out.split('{' + k + '}').join(vars[k]); });
    return out;
  }

  function apply(root) {
    const scope = root || document;
    Array.prototype.forEach.call(scope.querySelectorAll('[data-i18n]'), node => {
      node.innerHTML = t(node.getAttribute('data-i18n'));
    });
    Array.prototype.forEach.call(scope.querySelectorAll('[data-i18n-ph]'), node => {
      node.setAttribute('placeholder', t(node.getAttribute('data-i18n-ph')));
    });
    Array.prototype.forEach.call(scope.querySelectorAll('[data-i18n-aria]'), node => {
      node.setAttribute('aria-label', t(node.getAttribute('data-i18n-aria')));
    });
    Array.prototype.forEach.call(scope.querySelectorAll('[data-i18n-title]'), node => {
      node.setAttribute('title', t(node.getAttribute('data-i18n-title')));
    });
    document.documentElement.lang = lang;
    document.documentElement.dir = lang === 'ar' ? 'rtl' : 'ltr';
    const btn = document.getElementById('langBtn');
    if (btn) btn.textContent = lang === 'ar' ? 'EN' : 'ع';
    const sub = document.getElementById('viewSub');
    if (sub) {
      const cur = document.querySelector('.dock [data-nav].is-active');
      const key = 'sub.' + (cur ? cur.dataset.nav : 'excel');
      sub.textContent = t(key);
    }
    document.title = t('app.name') + ' — ' + t('app.tagline');
  }

  function set(next, opts) {
    lang = next === 'ar' ? 'ar' : 'en';
    try { localStorage.setItem('qg.lang', lang); } catch (e) {}
    apply();
    if (!opts || !opts.silent) {
      if (QG.payments) QG.payments.renderPlans(), QG.payments.updateCheckout(), QG.payments.renderOrders && QG.payments.renderOrders();
      if (QG.tableView && QG.state.table) QG.tableView.render();
      if (QG.scriptView && QG.state.script) QG.scriptView.render();
      if (QG.auth) QG.auth.paint();
      if (QG.admin) QG.admin.render();
    }
    return lang;
  }

  function init() {
    let saved = 'en';
    try { saved = localStorage.getItem('qg.lang') || 'en'; } catch (e) {}
    lang = saved === 'ar' ? 'ar' : 'en';
    apply();
  }

  QG.t = t;
  QG.i18n = { t, apply, set, init, get lang() { return lang; }, dict: DICT };
})(window.QG);

