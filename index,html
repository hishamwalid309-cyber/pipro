      : ['Hi 👋', 'Transfer receipt attached:', 'Plan: ' + (o.plan || ''), 'Period: ' + (o.period || ''), 'Amount: ' + amount,
        'Method: ' + (o.method || ''), 'Order: ' + (o.id || ''), 'Sender: ' + (o.name || ''),
