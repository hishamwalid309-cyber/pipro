<script>
/* ---- auth.js ---- */
/* =============================================================================
   auth.js — direct Google sign-in through Google Identity Services.
   One click on "Continue with Google" opens the real Google account chooser in
   a popup and returns the profile — no password is ever stored here.
   Owner emails in CONFIG.ownerEmails keep full access; every other account
   needs an active subscription (see access.js).
   A static page cannot verify the Google token on a server, so put the site
   behind a small backend if you need hard security.
   ============================================================================= */
window.QG = window.QG || {};

(function (QG) {
  'use strict';

  const U = QG.util;
  const KEY = 'qg.session.v2';
  const USERS = 'qg.users.v1';
  const CID_KEY = 'qg.googleClientId';
  const GSI_SRC = 'https://accounts.google.com/gsi/client';

  const C = QG.CONFIG || {};
  const OWNERS = (C.ownerEmails || ['hishamwalid309@gmail.com']).map(function (e) { return String(e).toLowerCase().trim(); });
  const ADMIN_EMAIL = OWNERS[0];

  let session = U.store.get(KEY, null);
  let gsiPromise = null;

  /* ------------------------------------------------------------- helpers */
  function rawGet(k) { try { return localStorage.getItem(k) || ''; } catch (e) { return ''; } }
  function rawSet(k, v) { try { if (v) localStorage.setItem(k, v); else localStorage.removeItem(k); } catch (e) {} }

  function clientId() {
    const site = (QG.site && QG.site.get().googleClientId) || '';
    const stored = rawGet(CID_KEY);
    return String(site || stored || C.googleClientId || '').trim();
  }
  function setClientId(id) { rawSet(CID_KEY, String(id || '').trim()); }
  function needsSetup() { return !clientId(); }

  function decodeJwt(token) {
    try {
      const part = token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');
      const json = decodeURIComponent(atob(part).split('').map(function (c) {
        return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
      }).join(''));
      return JSON.parse(json);
    } catch (e) { return null; }
  }

  function normalise(profile) {
    const email = String(profile.email || '').toLowerCase().trim();
    const name = profile.name || email.split('@')[0] || 'Member';
    const owner = OWNERS.indexOf(email) > -1;
    return {
      email: email,
      name: name,
      picture: profile.picture || '',
      role: owner ? 'admin' : 'member',
      verified: profile.verified !== false,
      guest: false,
      at: Date.now()
    };
  }

  function remember(user) {
    if (!user.email) return;
    const all = U.store.get(USERS, []);
    const i = all.findIndex(function (u) { return u.email === user.email; });
    const rec = { email: user.email, name: user.name, role: user.role, last: Date.now() };
    if (i > -1) all[i] = rec; else all.push(rec);
    U.store.set(USERS, all.slice(-40));
  }

  function setSession(user) {
    session = user;
    U.store.set(KEY, user);
    remember(user);
    paint();
    document.dispatchEvent(new CustomEvent('qg:auth', { detail: user }));
  }

  function isAdmin() { return !!session && session.role === 'admin'; }
  function user() { return session; }
  function scopeKey() { return session && session.email ? 'u:' + session.email : 'guest'; }
  function projectId() {
    const s = session;
    return (s && s.email ? s.email.split('@')[0] : 'guest').replace(/[^a-z0-9._-]/gi, '') || 'guest';
  }

  /* --------------------------------------------------------------- paint */
  function paint() {
    const chip = U.$('#accountChip');
    const label = U.$('#accountLabel');
    const av = U.$('#accountAvatar');
    const dot = U.$('#accountDot');
    if (!chip) return;

    if (session && session.email) {
      const initials = String(session.name || session.email).trim().charAt(0).toUpperCase();
      if (av) {
        if (session.picture) { av.style.backgroundImage = 'url("' + session.picture + '")'; av.textContent = ''; }
        else { av.style.backgroundImage = 'none'; av.textContent = initials; }
      }
      if (label) label.textContent = session.name || session.email;
      if (dot) dot.hidden = session.role !== 'admin';
      chip.setAttribute('data-role', session.role);
      chip.title = session.email;
    } else {
      if (av) { av.style.backgroundImage = 'none'; av.textContent = '?'; }
      if (label) label.textContent = QG.t('auth.signin');
      if (dot) dot.hidden = true;
      chip.removeAttribute('data-role');
      chip.removeAttribute('title');
    }

    const adminLink = U.$('[data-act="open-admin"]');
    if (adminLink) adminLink.hidden = !isAdmin();
    const projNote = U.$('#projectScopeNote');
    if (projNote) projNote.textContent = QG.t('design.projectHint');
    if (QG.access) QG.access.update();
  }

  /* --------------------------------------------------------------- modal */
  function openModal() {
    const m = U.$('#authModal');
    if (!m) return;
    m.hidden = false;
    m.classList.add('is-open');
    const box = U.$('#authSetup');
    if (box) box.hidden = !needsSetup();
    const input = U.$('#gClientId');
    if (input && !input.value) input.value = clientId();
    hint(needsSetup() ? QG.t('auth.needId') : '');
    QG.sound.swoosh();
  }

  function closeModal() {
    const m = U.$('#authModal');
    if (!m) return;
    m.classList.remove('is-open');
    setTimeout(function () { m.hidden = true; }, 220);
    try { localStorage.setItem('qg.visited', '1'); } catch (e) {}
  }

  function hint(msg) {
    const h = U.$('#authHint');
    if (h) { h.textContent = msg || ''; h.hidden = !msg; }
  }

  /* ----------------------------------------------------------------- GIS */
  function loadGis() {
    if (window.google && window.google.accounts) return Promise.resolve();
    if (gsiPromise) return gsiPromise;
    gsiPromise = new Promise(function (resolve, reject) {
      const sc = document.createElement('script');
      sc.src = GSI_SRC;
      sc.async = true;
      sc.defer = true;
      sc.onload = function () { resolve(); };
      sc.onerror = function () { gsiPromise = null; reject(new Error('gsi')); };
      document.head.appendChild(sc);
    });
    return gsiPromise;
  }

  function finish(info) {
    const person = normalise(info || {});
    if (!person.email) { hint(QG.t('auth.failed')); return; }
    setSession(person);
    closeModal();
    U.toast(QG.t('auth.welcome', { name: person.name }), 'success');
    QG.sound.success();
    if (QG.access) QG.access.update();
  }

  /* official Google button — used when the popup is blocked */
  function renderFallback(cid) {
    const holder = U.$('#gsiButton');
    if (!holder || !window.google || !google.accounts || !google.accounts.id) return;
    try {
      google.accounts.id.initialize({
        client_id: cid,
        callback: function (res) {
          const payload = decodeJwt(res.credential);
          if (!payload || !payload.email) { hint(QG.t('auth.failed')); return; }
          finish({ email: payload.email, name: payload.name, picture: payload.picture, verified: payload.email_verified });
        },
        auto_select: false,
        cancel_on_tap_outside: true
      });
      holder.innerHTML = '';
      google.accounts.id.renderButton(holder, {
        theme: 'filled_black', size: 'large', shape: 'pill', text: 'continue_with', width: 300
      });
      hint(QG.t('auth.popup'));
    } catch (e) { hint(QG.t('auth.popup')); }
  }

  function signIn() {
    const cid = clientId();
    if (!cid) {
      const box = U.$('#authSetup');
      if (box) box.hidden = false;
      hint(QG.t('auth.needId'));
      QG.sound.error();
      return;
    }
    hint(QG.t('auth.working'));
    loadGis().then(function () {
      if (location.protocol === 'file:') hint(QG.t('auth.fileWarn'));
      const oauth = window.google && google.accounts && google.accounts.oauth2;
      if (!oauth) { renderFallback(cid); return; }
      try {
        const client = oauth.initTokenClient({
          client_id: cid,
          scope: 'openid email profile',
          prompt: 'select_account',
          callback: function (resp) {
            if (!resp || resp.error || !resp.access_token) { hint(QG.t('auth.cancelled')); return; }
            fetch('https://www.googleapis.com/oauth2/v3/userinfo', {
              headers: { Authorization: 'Bearer ' + resp.access_token }
            }).then(function (r) { return r.json(); }).then(function (info) {
              finish({ email: info.email, name: info.name, picture: info.picture, verified: info.email_verified });
            }).catch(function () { hint(QG.t('auth.failed')); });
          },
          error_callback: function () { renderFallback(cid); }
        });
        client.requestAccessToken({ prompt: 'select_account' });
      } catch (e) { renderFallback(cid); }
    }).catch(function () { hint(QG.t('auth.offline')); });
  }

  function signOut() {
    if (window.google && google.accounts && google.accounts.id) {
      try { google.accounts.id.disableAutoSelect(); } catch (e) {}
    }
    session = null;
    try { localStorage.removeItem(KEY); } catch (e) {}
    paint();
    document.dispatchEvent(new CustomEvent('qg:auth', { detail: null }));
    U.toast(QG.t('auth.signout'));
    if (QG.access) QG.access.update();
  }

  /* ----------------------------------------------------------------- wire */
  function wire() {
    paint();

    U.$$('[data-auth="google"]').forEach(function (b) {
      b.addEventListener('click', function (e) { e.preventDefault(); signIn(); });
    });

    U.$$('[data-auth="save-client"]').forEach(function (b) {
      b.addEventListener('click', function (e) {
        e.preventDefault();
        const input = U.$('#gClientId');
        const id = input ? input.value.trim() : '';
        if (!/\.apps\.googleusercontent\.com$/i.test(id)) { hint(QG.t('auth.badId')); QG.sound.error(); return; }
        setClientId(id);
        hint('');
        const box = U.$('#authSetup');
        if (box) box.hidden = true;
        U.toast(QG.t('auth.setupSaved'), 'success');
        QG.sound.success();
      });
    });

    U.$$('[data-auth="signout"]').forEach(function (b) { b.addEventListener('click', signOut); });
    U.$$('[data-auth="close"]').forEach(function (b) { b.addEventListener('click', closeModal); });

    const chip = U.$('#accountChip');
    if (chip) chip.addEventListener('click', function () {
      if (session && session.email) {
        const again = window.confirm(QG.t('auth.signedAs') + ': ' + session.email + '\n\n' + QG.t('auth.signout') + '?');
        if (again) signOut(); else closeModal();
      } else openModal();
    });

    const modal = U.$('#authModal');
    if (modal) modal.addEventListener('click', function (e) { if (e.target === modal) closeModal(); });

    if (!session) {
      let visited = false;
      try { visited = !!localStorage.getItem('qg.visited'); } catch (e) {}
      setTimeout(function () { if (!session) openModal(); }, visited ? 700 : 500);
    }
  }

  QG.auth = {
    wire: wire, paint: paint, openModal: openModal, closeModal: closeModal,
    signOut: signOut, signIn: signIn,
    isAdmin: isAdmin, user: user, scopeKey: scopeKey, projectId: projectId,
    clientId: clientId, setClientId: setClientId, needsSetup: needsSetup,
    ADMIN_EMAIL: ADMIN_EMAIL,
    get session() { return session; }
  };
})(window.QG);

</script>
<script>
/* ---- theme.js ---- */
/* =============================================================================
   theme.js — design system with two layers:
     • project theme  → owned by the signed-in person, saved per account
     • site default   → owned by the admin account only
   Every control writes a CSS variable or a data-attribute, then persists.
   ============================================================================= */
window.QG = window.QG || {};

(function (QG) {
  'use strict';

  const U = QG.util;
  const DEFAULT_KEY = 'qg.siteTheme';
  const PROJ_KEY = 'qg.projects';
  const scopeKey = () => 'qg.theme.' + (QG.auth ? QG.auth.scopeKey() : 'guest');

  QG.state = QG.state || { table: null, script: null, plan: 'studio', period: 'monthly', orders: [] };

  const PRESETS = {
    midnight:    { name: 'Midnight Aurum', bg: '#070b14', bg2: '#0b1220', text: '#eaf0fb', muted: '#93a1bb', accent: '#e8c06a', accent2: '#7c6cff' },
    cobalt:      { name: 'Cobalt Rail',    bg: '#05091a', bg2: '#0a1430', text: '#e8f0ff', muted: '#8fa3c4', accent: '#4d8dff', accent2: '#22d3ee' },
    ultraviolet: { name: 'Ultraviolet',    bg: '#0b0716', bg2: '#160d2a', text: '#f1eaff', muted: '#a08fc4', accent: '#b65cff', accent2: '#ff4d8d' },
    ember:       { name: 'Ember Desk',     bg: '#120a08', bg2: '#22110c', text: '#fdeee6', muted: '#c09a8b', accent: '#ff6b35', accent2: '#ffb15c' },
    mint:        { name: 'Neo Mint',       bg: '#04120f', bg2: '#08201b', text: '#e6fff8', muted: '#84b8a9', accent: '#37e6b4', accent2: '#5cc8ff' },
    porcelain:   { name: 'Porcelain',      bg: '#f6f3ee', bg2: '#ffffff', text: '#1b1a17', muted: '#6d6a62', accent: '#e4572e', accent2: '#2f6f6a' },
    sage:        { name: 'Sage Studio',    bg: '#f1f4ef', bg2: '#ffffff', text: '#1c2420', muted: '#5f6f66', accent: '#4f7a5b', accent2: '#b4863c' },
    noir:        { name: 'Noir Mono',      bg: '#0a0a0a', bg2: '#141414', text: '#f4f4f4', muted: '#8d8d8d', accent: '#f4f4f4', accent2: '#9a9a9a' }
  };

  const DEFAULTS = {
    preset: 'midnight',
    bg: PRESETS.midnight.bg, bg2: PRESETS.midnight.bg2,
    text: PRESETS.midnight.text, muted: PRESETS.midnight.muted,
    accent: PRESETS.midnight.accent, accent2: PRESETS.midnight.accent2,
    font: 'Sora', base: 15, radius: 22, blur: 22, glow: 45,
    density: 'cozy', headerStyle: 'fill', borders: 'rows',
    zebra: true, motion: true, showTotals: true,
    currency: 'EGP', numFormat: 'plain',
    company: '', footer: '', watermark: ''
  };

  let theme = Object.assign({}, DEFAULTS);

  /* ------------------------------------------------------------ project meta */
  function projects() { return U.store.get(PROJ_KEY, {}); }

  function projectName() {
    const rec = projects()[QG.auth.scopeKey()];
    return (rec && rec.name) || (QG.auth && QG.auth.session && !QG.auth.session.guest ? QG.auth.session.name + '’s project' : 'My project');
  }

  function setProjectName(name) {
    if (QG.access && !QG.access.requireAccess()) return;
    const all = projects();
    all[QG.auth.scopeKey()] = Object.assign({}, all[QG.auth.scopeKey()], { name: name });
    U.store.set(PROJ_KEY, all);
    U.toast(QG.t('toast.project', { name: name }), 'success');
    if (QG.tableView) QG.tableView.render();
  }

  /* ---------------------------------------------------------------- colour */
  function hexToRgb(hex) {
    let h = String(hex || '#000').replace('#', '');
    if (h.length === 3) h = h.split('').map(c => c + c).join('');
    const n = parseInt(h, 16) || 0;
    return { r: (n >> 16) & 255, g: (n >> 8) & 255, b: n & 255 };
  }
  const lum = hex => { const c = hexToRgb(hex); return (0.2126 * c.r + 0.7152 * c.g + 0.0722 * c.b) / 255; };
  const alpha = (hex, a) => { const c = hexToRgb(hex); return 'rgba(' + c.r + ',' + c.g + ',' + c.b + ',' + a + ')'; };

  /* ---------------------------------------------------------------- apply */
  function apply(skipRender) {
    const r = document.documentElement;
    const light = lum(theme.bg) > 0.55;
    const brand = (QG.site && QG.site.get().brand) || 'Quill & Grid';

    r.dataset.preset = theme.preset;
    r.dataset.density = theme.density;
    r.dataset.header = theme.headerStyle;
    r.dataset.borders = theme.borders;
    r.dataset.zebra = theme.zebra ? 'on' : 'off';
    r.dataset.motion = theme.motion ? 'on' : 'off';

    const set = (k, v) => r.style.setProperty(k, v);
    set('--bg', theme.bg);
    set('--bg-2', theme.bg2);
    set('--text', theme.text);
    set('--muted', theme.muted);
    set('--accent', theme.accent);
    set('--accent-2', theme.accent2);
    set('--accent-ink', lum(theme.accent) > 0.62 ? '#0a0c14' : '#ffffff');
    set('--accent-soft', alpha(theme.accent, light ? 0.14 : 0.16));
    set('--surface', light ? 'rgba(255,255,255,0.66)' : 'rgba(255,255,255,0.045)');
    set('--surface-2', light ? 'rgba(255,255,255,0.88)' : 'rgba(255,255,255,0.078)');
    set('--glass-border', light ? 'rgba(20,20,20,0.09)' : 'rgba(255,255,255,0.09)');
    set('--line', light ? 'rgba(20,20,20,0.085)' : 'rgba(255,255,255,0.08)');
    set('--line-strong', light ? 'rgba(20,20,20,0.18)' : 'rgba(255,255,255,0.18)');
    set('--paper', light ? 'rgba(255,255,255,0.92)' : 'rgba(255,255,255,0.028)');
    set('--shadow', light ? '0 22px 50px -30px rgba(30,25,20,0.45)' : '0 24px 60px -28px rgba(0,0,0,0.85)');
    set('--font', '"' + theme.font + '", system-ui, -apple-system, "Segoe UI", sans-serif');
    set('--base', theme.base + 'px');
    set('--radius', theme.radius + 'px');
    set('--blur', theme.blur + 'px');
    set('--glow', theme.glow + '%');

    document.body.style.background = theme.bg;
    const meta = document.querySelector('meta[name="theme-color"]');
    if (meta) meta.setAttribute('content', theme.bg);
    U.$$('.wordmark__name').forEach(n => {
      n.innerHTML = brand.replace(/\s*&\s*/, '&nbsp;<i>&amp;</i>&nbsp;');
    });

    U.store.set(scopeKey(), theme);
    paintControls();
    if (!skipRender && QG.tableView && QG.tableView.render) QG.tableView.render();
  }

  function set(patch) { Object.assign(theme, patch); apply(); }

  function reset() {
    theme = Object.assign({}, DEFAULTS, U.store.get(DEFAULT_KEY, {}));
    apply();
    U.toast(QG.t('toast.reset'));
  }

  function saveAsDefault() {
    if (!QG.auth || !QG.auth.isAdmin()) { U.toast(QG.t('toast.adminOnly'), 'error'); return; }
    U.store.set(DEFAULT_KEY, theme);
    U.toast(QG.t('admin.saved'), 'success');
    QG.sound.success();
  }

  function reload() {
    theme = Object.assign({}, DEFAULTS, U.store.get(DEFAULT_KEY, {}), U.store.get(scopeKey(), {}));
    apply(true);
    paintControls();
    if (QG.tableView && QG.state.table) QG.tableView.render();
  }

  /* ------------------------------------------------------------- controls */
  function paintControls() {
    const $ = U.$;
    const grid = $('#paletteGrid');
    if (grid) U.$$('.swatch', grid).forEach(b => b.classList.toggle('is-active', b.dataset.preset === theme.preset));
    U.$$('#paletteDots button').forEach(b => b.classList.toggle('is-active', b.dataset.preset === theme.preset));

    const bind = (sel, val) => { const n = $(sel); if (n && n.value !== String(val)) n.value = val; };
    bind('#cAccent', theme.accent); bind('#cAccent2', theme.accent2);
    bind('#cBg', theme.bg); bind('#cText', theme.text);
    bind('#fontSelect', theme.font); bind('#borders', theme.borders);
    bind('#density', theme.density); bind('#currency', theme.currency); bind('#numFormat', theme.numFormat);

    const slider = (sel, out, val) => {
      const n = $(sel); if (n) n.value = val;
      const o = $(out); if (o) o.textContent = val;
    };
    slider('#fontSize', '#fontSizeOut', theme.base);
    slider('#radius', '#radiusOut', theme.radius);
    slider('#blur', '#blurOut', theme.blur);
    slider('#glow', '#glowOut', theme.glow);

    const chk = (sel, val) => { const n = $(sel); if (n) n.checked = !!val; };
    chk('#zebra', theme.zebra); chk('#motion', theme.motion); chk('#totalsSwitch', theme.showTotals);

    U.$$('#segHeader button').forEach(b => b.classList.toggle('is-active', b.dataset.val === theme.headerStyle));

    const comp = $('#companyName'); if (comp && comp.value !== theme.company) comp.value = theme.company;
    const foot = $('#docFooter'); if (foot && foot.value !== theme.footer) foot.value = theme.footer;
    const wm = $('#watermark'); if (wm && wm.value !== theme.watermark) wm.value = theme.watermark;
    const pn = $('#projectName'); if (pn && pn.value !== projectName()) pn.value = projectName();
  }

  /* ---------------------------------------------------------- columns tab */
  function renderColumns() {
    const wrap = U.$('#columnList');
    if (!wrap) return;
    const table = QG.state.table;
    if (!table || !table.columns.length) {
      wrap.innerHTML = '<p class="cols__empty">' + QG.t('design.columnsHint') + '</p>';
      return;
    }
    wrap.innerHTML = '';
    table.columns.forEach((col, i) => {
      const row = U.el('div', { class: 'colrow' + (col.hidden ? ' is-hidden' : '') });
      row.innerHTML =
        '<button data-cmd="hide" title="Show / hide">' + (col.hidden ? '◌' : '◉') + '</button>' +
        '<input type="text" value="' + U.esc(col.label) + '" />' +
        '<button data-cmd="up" title="Move up">↑</button>' +
        '<button data-cmd="down" title="Move down">↓</button>';
      const input = row.querySelector('input');
      input.addEventListener('change', () => {
        table.columns[i].label = input.value.trim() || table.columns[i].label;
        QG.tableView.render(); QG.sound.click(0.8);
      });
      row.addEventListener('click', e => {
        const btn = e.target.closest('button');
        if (!btn) return;
        e.preventDefault();
        const cmd = btn.dataset.cmd;
        if (cmd === 'hide') table.columns[i].hidden = !table.columns[i].hidden;
        if (cmd === 'up' && i > 0) { const c = table.columns.splice(i, 1)[0]; table.columns.splice(i - 1, 0, c); }
        if (cmd === 'down' && i < table.columns.length - 1) { const c = table.columns.splice(i, 1)[0]; table.columns.splice(i + 1, 0, c); }
        QG.sound.click(); renderColumns(); QG.tableView.render();
      });
      wrap.appendChild(row);
    });
  }

  /* ------------------------------------------------------------ palette UI */
  function buildPaletteUI() {
    const grid = U.$('#paletteGrid');
    if (grid) {
      grid.innerHTML = '';
      Object.keys(PRESETS).forEach(key => {
        const p = PRESETS[key];
        const b = U.el('button', { class: 'swatch' + (theme.preset === key ? ' is-active' : ''), 'data-preset': key, title: p.name });
        b.style.background = 'linear-gradient(135deg,' + p.bg + ' 42%,' + p.accent + ' 43%, ' + p.accent2 + ')';
        b.innerHTML = '<span>' + p.name.split(' ')[0] + '</span>';
        grid.appendChild(b);
      });
    }
    const dots = U.$('#paletteDots');
    if (dots && !dots.children.length) {
      ['midnight', 'cobalt', 'ultraviolet', 'ember', 'porcelain'].forEach(key => {
        const p = PRESETS[key];
        const b = U.el('button', { 'data-preset': key, title: p.name, 'aria-label': p.name });
        b.style.background = 'linear-gradient(135deg,' + p.accent + ',' + p.accent2 + ')';
        dots.appendChild(b);
      });
    }
  }

  function usePreset(key) {
    const p = PRESETS[key];
    if (!p) return;
    Object.assign(theme, { preset: key, bg: p.bg, bg2: p.bg2, text: p.text, muted: p.muted, accent: p.accent, accent2: p.accent2 });
    apply();
    QG.sound.click(1.1);
  }

  function shuffle() {
    const keys = Object.keys(PRESETS);
    const key = keys[Math.floor(Math.random() * keys.length)];
    const headers = ['fill', 'line', 'pill', 'gradient', 'mono'];
    const borders = ['rows', 'grid', 'none'];
    const density = ['compact', 'cozy', 'roomy'];
    usePreset(key);
    theme.headerStyle = headers[Math.floor(Math.random() * headers.length)];
    theme.borders = borders[Math.floor(Math.random() * borders.length)];
    theme.density = density[Math.floor(Math.random() * density.length)];
    theme.font = ['Sora', 'Manrope', 'Inter', 'Space Grotesk', 'Instrument Serif'][Math.floor(Math.random() * 5)];
    apply();
    U.toast(QG.t('toast.shuffle', { name: PRESETS[key].name, header: theme.headerStyle }));
  }

  /* ----------------------------------------------------------------- wire */
  function wire() {
    buildPaletteUI();
    paintControls();
    const $ = U.$;

    document.addEventListener('click', e => {
      const sw = e.target.closest('[data-preset]');
      if (sw) usePreset(sw.dataset.preset);
    });

    const live = (sel, handler) => {
      const n = $(sel);
      if (!n) return;
      n.addEventListener('input', () => handler(n.value));
      n.addEventListener('change', () => { handler(n.value); QG.sound.click(0.8); });
    };

    live('#cAccent', v => set({ accent: v }));
    live('#cAccent2', v => set({ accent2: v }));
    live('#cBg', v => set({ bg: v }));
    live('#cText', v => set({ text: v }));
    live('#fontSelect', v => set({ font: v }));
    live('#borders', v => set({ borders: v }));
    live('#density', v => set({ density: v }));
    live('#currency', v => set({ currency: v }));
    live('#numFormat', v => set({ numFormat: v }));
    live('#fontSize', v => set({ base: +v }));
    live('#radius', v => set({ radius: +v }));
    live('#blur', v => set({ blur: +v }));
    live('#glow', v => set({ glow: +v }));
    live('#companyName', v => { theme.company = v; apply(); });
    live('#docFooter', v => { theme.footer = v; apply(); });
    live('#watermark', v => { theme.watermark = v; apply(); });
    live('#projectName', v => { theme._pendingName = v; });

    const pn = $('#projectName');
    if (pn) pn.addEventListener('change', () => { if (pn.value.trim()) setProjectName(pn.value.trim()); });

    ['#zebra', '#motion', '#totalsSwitch'].forEach(sel => {
      const n = $(sel);
      if (!n) return;
      n.addEventListener('change', () => {
        if (sel === '#zebra') theme.zebra = n.checked;
        if (sel === '#motion') theme.motion = n.checked;
        if (sel === '#totalsSwitch') theme.showTotals = n.checked;
        apply(); QG.sound.click(0.9);
      });
    });

    U.$$('#segHeader button').forEach(b => {
      b.addEventListener('click', () => {
        theme.headerStyle = b.dataset.val;
        apply();
        U.$$('#segHeader button').forEach(x => x.classList.toggle('is-active', x === b));
        QG.sound.click(0.9);
      });
    });

    document.addEventListener('qg:auth', reload);
  }

  reload();

  QG.theme = {
    PRESETS, DEFAULTS, get: () => theme, apply, set, reset, wire, shuffle,
    usePreset, renderColumns, saveAsDefault, reload, projectName, setProjectName,
    lum, alpha
  };
})(window.QG);

</script>
<script>
/* ---- table-engine.js ---- */
/* =============================================================================
   table-engine.js — natural language → structured, exportable table.
   Rule-based and fully deterministic (same brief = same sheet), no API needed.
   ============================================================================= */
window.QG = window.QG || {};

(function (QG) {
  'use strict';

  const U = QG.util;

  const NAMES = ['Nour Hassan', 'Omar Khaled', 'Salma Adel', 'Youssef Fathy', 'Mariam Tarek',
    'Ahmed Sobhy', 'Layla Nabil', 'Karim Mostafa', 'Hana Gamal', 'Ziad Ashraf',
    'Dina Farouk', 'Tamer Naguib', 'Aya Mahmoud', 'Hassan Radi', 'Rana Samir', 'Bassel Aziz'];

  const ROLES = ['Front desk', 'Barista', 'Sales lead', 'Cashier', 'Stock keeper', 'Designer',
    'Accountant', 'Runner', 'Shift lead', 'Support', 'Operations', 'Merchandiser'];

  const STATUS_PAID = [['Paid', 'ok'], ['Paid', 'ok'], ['Pending', 'warn'], ['Paid', 'ok'], ['On hold', 'bad']];

  const PRODUCTS = ['Ceramic mug', 'Cold brew 1L', 'Linen tote', 'Espresso beans 250g',
    'Desk planner', 'Leather wallet', 'Pour-over kit', 'Gift box', 'Notebook A5',
    'Candle — cedar', 'Steel straw set', 'Apron', 'Card holder', 'Travel tumbler'];

  const CATEGORIES = ['Packaging', 'Coffee', 'Merch', 'Equipment', 'Marketing', 'Rent', 'Salaries', 'Logistics'];

  const SERVICES = [
    ['Discovery workshop', 'Stakeholder interviews and scope', 1, 4500],
    ['Brand direction', 'Moodboards, palette, type pairing', 1, 6200],
    ['Landing page design', 'Hero, sections, mobile pass', 3, 1800],
    ['Copy pass', 'Headlines, body, CTA tuning', 2, 950],
    ['Build & handover', 'Static build, deploy, docs', 1, 5200]
  ];

  const TASKS = [
    ['Lock Q4 pricing sheet', 'Operations'],
    ['Rebuild onboarding email', 'Marketing'],
    ['Migrate invoices to new template', 'Finance'],
    ['Photograph new SKUs', 'Content'],
    ['Close supplier contract', 'Operations'],
    ['Audit stock counts', 'Warehouse'],
    ['Ship influencer kits', 'Marketing'],
    ['Reconcile March payouts', 'Finance']
  ];

  const COMPANIES = ['Nile & Co', 'Cairo Provisions', 'Delta Studio', 'Souq Nine', 'Aurora Labs',
    'Mint Market', 'Atlas Trading', 'Palm & Pine'];

  const STAGES = [['Lead', 'info'], ['Qualified', 'info'], ['Proposal', 'warn'], ['Won', 'ok'], ['Lost', 'bad']];

  /* ------------------------------------------------------------------ parse */
  function detectCurrency(low) {
    if (/(usd|dollar|\$)/.test(low)) return 'USD';
    if (/(eur|euro|€)/.test(low)) return 'EUR';
    if (/(sar|riyal|ريال)/.test(low)) return 'SAR';
    if (/(aed|dirham|درهم)/.test(low)) return 'AED';
    if (/(gbp|pound|£)/.test(low)) return 'GBP';
    return 'EGP';
  }

  function detectCount(low) {
    const m = low.match(/(\d{1,3})\s*(employees?|staff|people|persons?|team members?|members?|workers?|drivers?|items?|products?|skus?|rows?|records?|entries|clients?|customers?|tasks?|lines?|months?|days?)/);
    if (m) return U.clamp(parseInt(m[1], 10), 1, 60);
    const m2 = low.match(/\bfor\s+(\d{1,3})\b/);
    if (m2) return U.clamp(parseInt(m2[1], 10), 1, 60);
    return null;
  }

  function detectBase(low) {
    let m = low.match(/(?:salary|salaries|pay|wage|rate|price)\D{0,16}(\d[\d,]{2,9})/);
    if (!m) m = low.match(/(\d[\d,]{2,9})\s*(?:egp|usd|eur|sar|aed|gbp|base|salary|per month)/);
    if (m) {
      const n = parseInt(m[1].replace(/,/g, ''), 10);
      if (n >= 100) return n;
    }
    return null;
  }

  function detectNames(text) {
    const m = text.match(/\bnamed\s+([^.;\n]+)/i);
    if (!m) return null;
    const parts = m[1].split(/\s*,\s*|\s+and\s+/i).map(s => s.trim()).filter(Boolean);
    return parts.length ? parts : null;
  }

  function detectColumns(text) {
    const m = text.match(/\b(?:with\s+)?columns?\s*(?:called|named)?\s*[:\-]?\s*([^.;\n]+)/i);
    if (!m) return null;
    const parts = m[1].split(/\s*,\s*|\s+and\s+/i).map(s => s.trim()).filter(s => s.length > 1 && s.length < 28);
    return parts.length > 1 ? parts : null;
  }

  function detectPeriod(text, low) {
    const now = new Date();
    const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
    let start, end, label;

    if (/next week/.test(low)) {
      start = U.addDays(U.startOfWeek(today), 7);
      end = U.addDays(start, 6);
      label = 'Next week';
    } else if (/this week/.test(low) || /\bweek\b/.test(low)) {
      start = U.startOfWeek(today);
      end = U.addDays(start, 6);
      label = 'This week';
    } else if (/next month/.test(low)) {
      start = new Date(today.getFullYear(), today.getMonth() + 1, 1);
      end = new Date(today.getFullYear(), today.getMonth() + 2, 0);
      label = 'Next month';
    } else if (/this month/.test(low) || /\bmonth\b/.test(low)) {
      start = new Date(today.getFullYear(), today.getMonth(), 1);
      end = new Date(today.getFullYear(), today.getMonth() + 1, 0);
      label = 'This month';
    } else {
      const q = low.match(/\bq([1-4])\b/);
      if (q) {
        const qi = parseInt(q[1], 10) - 1;
        start = new Date(today.getFullYear(), qi * 3, 1);
        end = new Date(today.getFullYear(), qi * 3 + 3, 0);
        label = 'Q' + (qi + 1) + ' ' + today.getFullYear();
      } else {
        start = U.startOfWeek(today);
        end = U.addDays(start, 6);
        label = 'This week';
      }
    }
    return { start, end, label };
  }

  function detectIntent(low) {
    if (/(schedule|rota|roster|shift|timetable|calendar|جدول)/.test(low)) return 'schedule';
    if (/(payroll|salar|wage|راتب|رواتب)/.test(low)) return 'payroll';
    if (/(invoice|quote|quotation|فاتورة|bill)/.test(low)) return 'invoice';
    if (/(inventory|stock|warehouse|skus?|مخزون)/.test(low)) return 'inventory';
    if (/(budget|expense|spend|cost breakdown|ميزانية)/.test(low)) return 'budget';
    if (/(task|project|sprint|backlog|to-?do|مهام)/.test(low)) return 'tasks';
    if (/(contact|client list|leads|crm|customers?|عملاء)/.test(low)) return 'contacts';
    if (/(sales|revenue|report|مبيعات)/.test(low)) return 'sales';
    return 'generic';
  }

  function fmtRange(start, end) {
    const o = { day: 'numeric', month: 'short' };
    const s = start.toLocaleDateString('en-GB', o);
    const e = end.toLocaleDateString('en-GB', Object.assign({ year: 'numeric' }, o));
    return s + ' – ' + e;
  }

  /* ------------------------------------------------------------- generators */
  function payroll(ctx) {
    const { rand, currency, count } = ctx;
    const base = ctx.base || 12000;
    const cols = [
      { key: 'idx', label: '#', type: 'index', width: 40 },
      { key: 'name', label: 'Employee', type: 'text' },
      { key: 'role', label: 'Role', type: 'text' },
      { key: 'base', label: 'Base salary', type: 'money', total: true },
      { key: 'allowance', label: 'Allowance', type: 'money', total: true },
      { key: 'deduction', label: 'Deductions', type: 'money', total: true },
      { key: 'net', label: 'Net pay', type: 'money', total: true, strong: true },
      { key: 'status', label: 'Status', type: 'badge' }
    ];
    const rows = [];
    for (let i = 0; i < count; i++) {
      const b = base + (i % 3) * Math.round(base * 0.12 / 100) * 100 + (rand() > 0.7 ? 500 : 0);
      const allow = Math.round(b * (0.08 + rand() * 0.08) / 50) * 50;
      const deduct = rand() > 0.55 ? Math.round(b * (0.03 + rand() * 0.06) / 50) * 50 : 0;
      const st = U.pick(rand, STATUS_PAID);
      rows.push({
        idx: i + 1, name: NAMES[i % NAMES.length], role: U.pick(rand, ROLES),
        base: b, allowance: allow, deduction: deduct, net: b + allow - deduct,
        status: { text: st[0], tone: st[1] }
      });
    }
    return {
      title: 'Payroll sheet', subtitle: ctx.period.label + ' · ' + count + ' people',
      columns: cols, rows, currency
    };
  }

  function schedule(ctx) {
    const { rand, count, currency } = ctx;
    const days = /7|week/.test(ctx.low) ? 7 : (detectCount(ctx.low) || 7);
    const staff = ctx.names || NAMES.slice(0, count);
    const withPay = /(salary|salaries|pay|rate|cost|wage)/.test(ctx.low);
    const rate = ctx.base ? Math.max(50, Math.round((ctx.base / 176) / 5) * 5) : 120;

    const cols = [
      { key: 'idx', label: '#', type: 'index', width: 40 },
      { key: 'day', label: 'Day', type: 'text' },
      { key: 'date', label: 'Date', type: 'date' },
      { key: 'shift', label: 'Shift', type: 'badge' },
      { key: 'name', label: 'Employee', type: 'text' },
      { key: 'hours', label: 'Hours', type: 'number', total: true },
      { key: 'start', label: 'Start', type: 'time' },
      { key: 'end', label: 'End', type: 'time' }
    ];
    if (withPay) {
      cols.push({ key: 'rate', label: 'Rate / hr', type: 'money' });
      cols.push({ key: 'total', label: 'Day total', type: 'money', total: true, strong: true });
    }

    const shifts = [
      { name: 'Morning', tone: 'info', start: '09:00', end: '17:00', hours: 8 },
      { name: 'Evening', tone: 'warn', start: '14:00', end: '22:00', hours: 8 },
      { name: 'Night', tone: 'bad', start: '22:00', end: '06:00', hours: 8 }
    ];

    const rows = [];
    for (let i = 0; i < days; i++) {
      const d = U.addDays(ctx.period.start, i);
      const sh = shifts[i % shifts.length];
      const row = {
        idx: i + 1, day: U.dayName(d), date: U.fmtDate(d),
        shift: { text: sh.name, tone: sh.tone }, name: staff[i % staff.length],
        hours: sh.hours, start: sh.start, end: sh.end
      };
      if (withPay) { row.rate = rate; row.total = rate * sh.hours; }
      rows.push(row);
    }
    return {
      title: 'Shift rota', subtitle: fmtRange(ctx.period.start, ctx.period.end) + ' · ' + staff.length + ' staff',
      columns: cols, rows, currency
    };
  }

  function invoice(ctx) {
    const { rand, currency } = ctx;
    const n = U.clamp(ctx.count || 5, 3, 8);
    const cols = [
      { key: 'idx', label: '#', type: 'index', width: 40 },
      { key: 'item', label: 'Item', type: 'text' },
      { key: 'desc', label: 'Description', type: 'text' },
      { key: 'qty', label: 'Qty', type: 'number' },
      { key: 'rate', label: 'Rate', type: 'money' },
      { key: 'amount', label: 'Amount', type: 'money', total: true, strong: true }
    ];
    const rows = [];
    for (let i = 0; i < n && i < SERVICES.length; i++) {
      const s = SERVICES[i];
      const qty = s[2] + (rand() > 0.75 ? 1 : 0);
      rows.push({ idx: i + 1, item: s[0], desc: s[1], qty, rate: s[3], amount: qty * s[3] });
    }
    const total = rows.reduce((a, r) => a + r.amount, 0);
    return {
      title: 'Invoice', subtitle: 'Draft · due in 14 days',
      columns: cols, rows, currency,
      meta: [
        ['Invoice', 'QG-2026-' + (100 + Math.floor(rand() * 800))],
        ['Issued', U.fmtDate(new Date())],
        ['Due', U.fmtDate(U.addDays(new Date(), 14))],
        ['Total', U.money(total, currency, 'plain')]
      ]
    };
  }

  function inventory(ctx) {
    const { rand, count, currency } = ctx;
    const cats = ['Packaging', 'Merch', 'Coffee', 'Equipment'];
    const cols = [
      { key: 'idx', label: '#', type: 'index', width: 40 },
      { key: 'sku', label: 'SKU', type: 'code' },
      { key: 'item', label: 'Item', type: 'text' },
      { key: 'category', label: 'Category', type: 'text' },
      { key: 'qty', label: 'On hand', type: 'number', total: true },
      { key: 'reorder', label: 'Reorder at', type: 'number' },
      { key: 'cost', label: 'Unit cost', type: 'money' },
      { key: 'value', label: 'Stock value', type: 'money', total: true, strong: true },
      { key: 'status', label: 'Status', type: 'badge' }
    ];
    const rows = [];
    for (let i = 0; i < count; i++) {
      const qty = Math.floor(rand() * 140);
      const reorder = 20 + Math.floor(rand() * 4) * 10;
      const cost = Math.round((80 + rand() * 900) / 5) * 5;
      const status = qty === 0 ? { text: 'Out', tone: 'bad' }
        : qty < reorder ? { text: 'Reorder', tone: 'warn' }
          : { text: 'Healthy', tone: 'ok' };
      rows.push({
        idx: i + 1, sku: 'QG-' + String(1000 + i * 7 + Math.floor(rand() * 6)),
        item: PRODUCTS[i % PRODUCTS.length], category: cats[i % cats.length],
        qty, reorder, cost, value: qty * cost, status
      });
    }
    return { title: 'Inventory tracker', subtitle: count + ' SKUs · live counts', columns: cols, rows, currency };
  }

  function budget(ctx) {
    const { rand, currency } = ctx;
    const cols = [
      { key: 'idx', label: '#', type: 'index', width: 40 },
      { key: 'category', label: 'Category', type: 'text' },
      { key: 'planned', label: 'Planned', type: 'money', total: true },
      { key: 'actual', label: 'Actual', type: 'money', total: true },
      { key: 'variance', label: 'Variance', type: 'money', total: true, strong: true },
      { key: 'used', label: 'Used', type: 'bar' },
      { key: 'note', label: 'Note', type: 'text' }
    ];
    const rows = [];
    const notes = ['On plan', 'Overspend — review', 'Under budget', 'One-off purchase', 'Renegotiated', 'Paid early'];
    CATEGORIES.forEach((c, i) => {
      const planned = Math.round((4000 + rand() * 26000) / 100) * 100;
      const actual = Math.round(planned * (0.6 + rand() * 0.7) / 100) * 100;
      rows.push({
        idx: i + 1, category: c, planned, actual, variance: planned - actual,
        used: Math.round((actual / planned) * 100), note: U.pick(rand, notes)
      });
    });
    return { title: 'Budget vs actual', subtitle: ctx.period.label + ' · ' + CATEGORIES.length + ' categories', columns: cols, rows, currency };
  }

  function tasks(ctx) {
    const { rand, count } = ctx;
    const cols = [
      { key: 'idx', label: '#', type: 'index', width: 40 },
      { key: 'task', label: 'Task', type: 'text' },
      { key: 'owner', label: 'Owner', type: 'text' },
      { key: 'start', label: 'Start', type: 'date' },
      { key: 'due', label: 'Due', type: 'date' },
      { key: 'priority', label: 'Priority', type: 'badge' },
      { key: 'status', label: 'Status', type: 'badge' },
      { key: 'hours', label: 'Est. hrs', type: 'number', total: true }
    ];
    const prio = [['High', 'bad'], ['Medium', 'warn'], ['Low', 'info']];
    const stat = [['To do', 'info'], ['In progress', 'warn'], ['Done', 'ok']];
    const rows = [];
    for (let i = 0; i < count; i++) {
      const t = TASKS[i % TASKS.length];
      const start = U.addDays(ctx.period.start, i);
      rows.push({
        idx: i + 1, task: t[0], owner: NAMES[(i + 2) % NAMES.length],
        start: U.fmtDate(start), due: U.fmtDate(U.addDays(start, 3 + Math.floor(rand() * 5))),
        priority: pickTone(rand, prio), status: pickTone(rand, stat),
        hours: 2 + Math.floor(rand() * 10)
      });
    }
    return { title: 'Task board export', subtitle: count + ' tasks · ' + ctx.period.label, columns: cols, rows };
  }

  function contacts(ctx) {
    const { rand, count, currency } = ctx;
    const cols = [
      { key: 'idx', label: '#', type: 'index', width: 40 },
      { key: 'name', label: 'Name', type: 'text' },
      { key: 'company', label: 'Company', type: 'text' },
      { key: 'email', label: 'Email', type: 'code' },
      { key: 'phone', label: 'Phone', type: 'code' },
      { key: 'stage', label: 'Stage', type: 'badge' },
      { key: 'value', label: 'Deal value', type: 'money', total: true, strong: true }
    ];
    const rows = [];
    for (let i = 0; i < count; i++) {
      const name = NAMES[(i + 4) % NAMES.length];
      rows.push({
        idx: i + 1, name, company: COMPANIES[i % COMPANIES.length],
        email: name.toLowerCase().replace(/[^a-z]+/g, '.') + '@' + COMPANIES[i % COMPANIES.length].toLowerCase().replace(/[^a-z]+/g, '') + '.com',
        phone: '01' + (Math.floor(rand() * 3) + 1) + ' ' + String(10000000 + Math.floor(rand() * 89999999)).slice(0, 4) + ' ' + String(1000 + Math.floor(rand() * 8999)),
        stage: pickTone(rand, STAGES),
        value: Math.round((8000 + rand() * 90000) / 500) * 500
      });
    }
    return { title: 'Client pipeline', subtitle: count + ' contacts · updated today', columns: cols, rows, currency };
  }

  function sales(ctx) {
    const { rand, count, currency } = ctx;
    const cols = [
      { key: 'idx', label: '#', type: 'index', width: 40 },
      { key: 'product', label: 'Product', type: 'text' },
      { key: 'units', label: 'Units', type: 'number', total: true },
      { key: 'price', label: 'Unit price', type: 'money' },
      { key: 'revenue', label: 'Revenue', type: 'money', total: true, strong: true },
      { key: 'share', label: 'Share', type: 'bar' },
      { key: 'trend', label: 'Trend', type: 'badge' }
    ];
    const n = U.clamp(count || 6, 3, 14);
    const rows = [];
    let sum = 0;
    for (let i = 0; i < n; i++) {
      const units = 30 + Math.floor(rand() * 320);
      const price = Math.round((120 + rand() * 900) / 10) * 10;
      const rev = units * price;
      sum += rev;
      const up = rand() > 0.32;
      rows.push({
        idx: i + 1, product: PRODUCTS[i % PRODUCTS.length], units, price, revenue: rev,
        share: 0, trend: { text: (up ? '+' : '−') + (2 + Math.floor(rand() * 28)) + '%', tone: up ? 'ok' : 'bad' }
      });
    }
    rows.forEach(r => { r.share = Math.round((r.revenue / sum) * 100); });
    rows.sort((a, b) => b.revenue - a.revenue);
    rows.forEach((r, i) => { r.idx = i + 1; });
    return {
      title: 'Sales report', subtitle: ctx.period.label + ' · ' + n + ' products · ' + U.money(sum, currency, 'compact') + ' total',
      columns: cols, rows, currency
    };
  }

  function generic(ctx) {
    const { rand, count, currency } = ctx;
    const custom = ctx.columns;
    let cols;
    if (custom) {
      cols = [{ key: 'idx', label: '#', type: 'index', width: 40 }].concat(
        custom.map((label, i) => ({
          key: 'c' + i, label: label,
          type: /price|cost|total|amount|salary|revenue|budget/i.test(label) ? 'money'
            : /qty|quantity|count|units|hours|days|number/i.test(label) ? 'number'
              : /date|day/i.test(label) ? 'date' : 'text',
          total: /price|cost|total|amount|qty|units|hours/i.test(label)
        }))
      );
      const rows = [];
      for (let i = 0; i < count; i++) {
        const row = { idx: i + 1 };
        cols.slice(1).forEach(c => {
          row[c.key] = c.type === 'money' ? Math.round((200 + rand() * 4000) / 10) * 10
            : c.type === 'number' ? 1 + Math.floor(rand() * 40)
              : c.type === 'date' ? U.fmtDate(U.addDays(ctx.period.start, i))
                : PRODUCTS[i % PRODUCTS.length];
        });
        rows.push(row);
      }
      return { title: 'Custom sheet', subtitle: count + ' rows · ' + custom.length + ' columns', columns: cols, rows, currency };
    }

    cols = [
      { key: 'idx', label: '#', type: 'index', width: 40 },
      { key: 'item', label: 'Item', type: 'text' },
      { key: 'category', label: 'Category', type: 'text' },
      { key: 'qty', label: 'Qty', type: 'number', total: true },
      { key: 'price', label: 'Unit price', type: 'money' },
      { key: 'total', label: 'Total', type: 'money', total: true, strong: true },
      { key: 'note', label: 'Note', type: 'text' }
    ];
    const notes = ['Recurring', 'One-off', 'Review', 'Approved', 'Draft', 'Paid'];
    const rows = [];
    for (let i = 0; i < count; i++) {
      const qty = 1 + Math.floor(rand() * 24);
      const price = Math.round((150 + rand() * 2400) / 10) * 10;
      rows.push({
        idx: i + 1, item: PRODUCTS[i % PRODUCTS.length], category: CATEGORIES[i % CATEGORIES.length],
        qty, price, total: qty * price, note: U.pick(rand, notes)
      });
    }
    return { title: 'Working sheet', subtitle: count + ' rows · ' + ctx.period.label, columns: cols, rows, currency };
  }

  function pickTone(rand, pairs) {
    const p = U.pick(rand, pairs);
    return { text: p[0], tone: p[1] };
  }

  /* -------------------------------------------------------------- generate */
  function generate(prompt, bump) {
    const text = String(prompt || '').trim();
    const low = text.toLowerCase();
    const rand = U.rng(U.hash(low) + (bump || 0) * 7919);
    const intent = detectIntent(low);
    const period = detectPeriod(text, low);

    const ctx = {
      prompt: text, low, rand, period,
      currency: detectCurrency(low),
      count: detectCount(low) || (intent === 'budget' ? CATEGORIES.length : 8),
      base: detectBase(low),
      names: detectNames(text),
      columns: detectColumns(text)
    };

    const builders = { payroll, schedule, invoice, inventory, budget, tasks, contacts, sales, generic };
    const out = builders[intent](ctx);

    const table = Object.assign({
      id: 't' + Date.now().toString(36),
      intent,
      prompt: text,
      currency: ctx.currency,
      createdAt: new Date(),
      meta: null
    }, out);

    table.currency = table.currency || ctx.currency;
    return table;
  }

  /* ------------------------------------------------------------------- ops */
  function findCol(table, name) {
    const n = String(name || '').toLowerCase().trim().replace(/[.,!?]+$/, '');
    if (!n) return null;
    return table.columns.find(c => c.label.toLowerCase() === n)
      || table.columns.find(c => c.label.toLowerCase().indexOf(n) === 0)
      || table.columns.find(c => c.label.toLowerCase().indexOf(n) > -1)
      || table.columns.find(c => c.key === n);
  }

  function applyOp(table, prompt) {
    if (!table) return null;
    const low = prompt.toLowerCase().trim();

    /* rename */
    let m = low.match(/rename\s+(?:column\s+|the\s+)?["']?(.+?)["']?\s+(?:to|as)\s+["']?(.+?)["']?$/);
    if (m) {
      const col = findCol(table, m[1]);
      if (col) {
        const old = col.label;
        col.label = prompt.match(/(?:to|as)\s+["']?(.+?)["']?\s*$/i)[1].trim();
        return { reply: 'Renamed <b>' + U.esc(old) + '</b> to <b>' + U.esc(col.label) + '</b>. The export uses the new header.' };
      }
    }

    /* sort */
    m = low.match(/sort(?:ed)?\s+by\s+(.+?)(\s+desc(?:ending)?|\s+asc(?:ending)?)?$/);
    if (m) {
      const col = findCol(table, m[1]);
      if (col) {
        const dir = /desc/.test(m[2] || '') ? -1 : 1;
        const val = r => {
          const v = r[col.key];
          if (v && typeof v === 'object') return String(v.text);
          return v;
        };
        table.rows.sort((a, b) => {
          const x = val(a), y = val(b);
          if (typeof x === 'number' && typeof y === 'number') return (x - y) * dir;
          return String(x).localeCompare(String(y)) * dir;
        });
        if (table.columns[0] && table.columns[0].type === 'index') table.rows.forEach((r, i) => { r.idx = i + 1; });
        return { reply: 'Sorted by <b>' + U.esc(col.label) + '</b> ' + (dir < 0 ? 'descending' : 'ascending') + '.' };
      }
    }

    /* hide / show */
    m = low.match(/(hide|show)\s+(?:the\s+)?(.+?)(?:\s+column)?$/);
    if (m) {
      const col = findCol(table, m[2]);
      if (col) {
        col.hidden = m[1] === 'hide';
        return { reply: (col.hidden ? 'Hidden <b>' : 'Showing <b>') + U.esc(col.label) + '</b> — headers stay editable in Design.' };
      }
    }

    /* remove */
    m = low.match(/(?:remove|delete|drop)\s+(?:the\s+)?(?:column\s+)?(.+)$/);
    if (m) {
      const col = findCol(table, m[1]);
      if (col && table.columns.length > 2) {
        table.columns = table.columns.filter(c => c !== col);
        return { reply: 'Dropped <b>' + U.esc(col.label) + '</b> from the sheet.' };
      }
    }

    /* add column */
    m = low.match(/add\s+(?:a\s+|an\s+)?(?:new\s+)?column\s+(?:called\s+|named\s+)?["']?(.+?)["']?$/);
    if (m) {
      const label = prompt.match(/column\s+(?:called\s+|named\s+)?["']?(.+?)["']?\s*$/i)[1].trim();
      const key = 'x' + table.columns.length;
      table.columns.push({ key, label, type: 'text' });
      table.rows.forEach((r, i) => { r[key] = ['—', 'Review', 'Approved', 'Follow up', 'N/A'][i % 5]; });
      return { reply: 'Added <b>' + U.esc(label) + '</b>. Rename or reorder it any time in Design → Columns.' };
    }

    /* totals */
    if (/total(s)?\s+row|add\s+total/.test(low)) {
      return { reply: 'Totals are on. Toggle them from the preview footer or Design → Table treatment.' };
    }

    /* row count */
    m = low.match(/(\d{1,3})\s*(?:more\s+)?(?:rows|records|entries|lines)/);
    if (m && /(make|set|change|add|expand|shrink|only|keep)/.test(low)) {
      const n = U.clamp(parseInt(m[1], 10), 1, 60);
      if (n > table.rows.length) {
        const proto = table.rows[table.rows.length - 1] || {};
        const seed = U.rng(U.hash(table.prompt + n));
        for (let i = table.rows.length; i < n; i++) {
          const row = {};
          Object.keys(proto).forEach(k => { row[k] = typeof proto[k] === 'number' ? Math.max(1, Math.round(proto[k] * (0.8 + seed() * 0.5))) : proto[k]; });
          row.idx = i + 1;
          if (row.name) row.name = NAMES[(i + 3) % NAMES.length];
          table.rows.push(row);
        }
      } else {
        table.rows = table.rows.slice(0, n);
      }
      return { reply: 'Sheet now holds <b>' + table.rows.length + ' rows</b>.' };
    }

    return null;
  }

  QG.TableEngine = { generate, applyOp, detectIntent };
})(window.QG);

</script>
<script>
/* ---- table-view.js ---- */
/* =============================================================================
   table-view.js — chat surface, 5-second job loader, sheet renderer, exports
   ============================================================================= */
window.QG = window.QG || {};

(function (QG) {
  'use strict';

  const U = QG.util;

  /* ------------------------------------------------------------- job veil */
  let busy = false;

  function runJob(opts) {
    const veil = U.$('#veil');
    const bar = U.$('#veilBar');
    const pct = U.$('#veilPct');
    const label = U.$('#veilLabel');
    const list = U.$('#veilSteps');
    const ms = opts.ms || 5000;
    const steps = opts.steps || ['Reading the brief', 'Shaping columns', 'Filling rows', 'Polishing the layout'];

    label.textContent = steps[0];
    list.innerHTML = steps.map(s => '<div>' + U.esc(s) + '</div>').join('');
    const nodes = U.$$('div', list);
    veil.hidden = false;
    let done = 0;

    return new Promise(resolve => {
      const t0 = performance.now();
      (function frame() {
        const p = Math.min(1, (performance.now() - t0) / ms);
        const eased = p < 0.5 ? 2 * p * p : 1 - Math.pow(-2 * p + 2, 2) / 2;
        if (bar) bar.style.strokeDashoffset = String(264 * (1 - eased));
        if (pct) pct.textContent = Math.round(eased * 100) + '%';
        const idx = Math.min(steps.length - 1, Math.floor(eased * steps.length));
        if (label && label.textContent !== steps[idx]) label.textContent = steps[idx];
        if (idx > done) {
          nodes.forEach((n, i) => n.classList.toggle('is-done', i < idx));
          done = idx;
          QG.sound.pulse();
        }
        if (p < 1) requestAnimationFrame(frame);
        else {
          nodes.forEach(n => n.classList.add('is-done'));
          setTimeout(() => { veil.hidden = true; resolve(); }, 260);
        }
      })();
    });
  }
  QG.job = { run: runJob };

  /* ----------------------------------------------------------------- chat */
  function bubble(role, html) {
    const chat = U.$('#excelChat');
    const msg = U.el('div', { class: 'msg msg--' + role });
    msg.innerHTML =
      '<div class="msg__avatar">' + (role === 'ai'
        ? '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M3 9h18M9 9v12"/></svg>'
        : '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="8" r="3.4"/><path d="M5 20c1.5-3.5 4-5 7-5s5.5 1.5 7 5"/></svg>') + '</div>' +
      '<div class="msg__body"><span class="msg__meta">' + (role === 'ai' ? 'Studio' : 'You') + '</span>' +
      '<div class="bubble">' + html + '</div></div>';
    chat.appendChild(msg);
    chat.scrollTop = chat.scrollHeight + 200;
    return msg;
  }

  function typing() {
    const chat = U.$('#excelChat');
    const msg = U.el('div', { class: 'msg msg--ai', id: 'typingMsg' });
    msg.innerHTML = '<div class="msg__avatar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M3 9h18M9 9v12"/></svg></div>' +
      '<div class="msg__body"><span class="msg__meta">Studio</span><div class="bubble"><span class="typing"><i></i><i></i><i></i></span></div></div>';
    chat.appendChild(msg);
    chat.scrollTop = chat.scrollHeight;
  }

  function endTyping() {
    const n = U.$('#typingMsg');
    if (n) n.remove();
  }

  /* --------------------------------------------------------------- render */
  function cellValue(row, col, theme) {
    const v = row[col.key];
    if (v == null || v === '') return '<span class="muted">—</span>';
    switch (col.type) {
      case 'index': return '<span class="idx">' + String(v).padStart(2, '0') + '</span>';
      case 'money': return U.money(v, theme.currency, theme.numFormat);
      case 'number': return U.num(v, theme.numFormat);
      case 'percent': return v + '%';
      case 'date':
        return new Date(v).toLocaleDateString('en-GB', { day: '2-digit', month: 'short' });
      case 'time': return U.esc(v);
      case 'code': return '<span style="font-family:var(--mono);font-size:11.4px">' + U.esc(v) + '</span>';
      case 'badge':
        if (typeof v === 'object') return '<span class="badge badge--' + v.tone + '">' + U.esc(v.text) + '</span>';
        return '<span class="badge">' + U.esc(v) + '</span>';
      case 'bar': {
        const p = U.clamp(Number(v) || 0, 0, 130);
        return '<div style="display:flex;align-items:center;gap:8px"><div class="bar"><i style="width:' + Math.min(100, p) + '%"></i></div><span class="muted" style="font-size:10.5px">' + Math.round(v) + '%</span></div>';
      }
      default: return U.esc(v);
    }
  }

  function rawValue(row, col) {
    const v = row[col.key];
    if (v == null) return '';
    if (typeof v === 'object') return v.text;
    return v;
  }

  function totalsFor(table, cols) {
    const out = {};
    cols.forEach(c => {
      if (!c.total) return;
      out[c.key] = table.rows.reduce((a, r) => a + (Number(r[c.key]) || 0), 0);
    });
    return out;
  }

  function render() {
    const stage = U.$('#tableStage');
    const t = QG.state.table;
    const th = QG.theme.get();
    if (!stage) return;
    if (!t) return;

    const cols = t.columns.filter(c => !c.hidden);
    const totals = totalsFor(t, cols);
    const hasTotals = th.showTotals && Object.keys(totals).length > 0;

    const head = `<div class="sheet__head">
        <div>
          <div class="sheet__brand">${U.esc(th.company || 'Quill & Grid')}</div>
          <h3 class="sheet__title">${U.esc(t.title)}</h3>
          <p class="sheet__sub">${U.esc(t.subtitle || '')}</p>
        </div>
        <div class="sheet__stamp">
          <b>${t.rows.length} rows</b>
          ${cols.length} columns<br/>
          ${U.fmtDate(t.createdAt || new Date())}<br/>
          ${U.esc(t.currency || th.currency)}
        </div>
      </div>`;

    const thead = '<thead><tr>' + cols.map(c =>
      '<th class="' + (c.type === 'money' || c.type === 'number' ? 'num' : c.type === 'index' ? 'center' : '') + '"' +
      (c.width ? ' style="width:' + c.width + 'px"' : '') + '>' + U.esc(c.label) + '</th>').join('') + '</tr></thead>';

    const tbody = '<tbody>' + t.rows.map(r => '<tr>' + cols.map(c =>
      '<td class="' + (c.type === 'money' || c.type === 'number' ? 'num' : c.type === 'index' ? 'center' : '') + (c.strong ? ' strong' : '') + '">' +
      cellValue(r, c, th) + '</td>').join('') + '</tr>').join('') + '</tbody>';

    let tfoot = '';
    if (hasTotals) {
      tfoot = '<tfoot><tr>' + cols.map((c, i) => {
        if (i === 0) return '<td class="center">Σ</td>';
        if (totals[c.key] == null) return '<td>' + (i === 1 ? 'Total' : '') + '</td>';
        return '<td class="num">' + (c.type === 'money' ? U.money(totals[c.key], th.currency, th.numFormat) : U.num(totals[c.key], th.numFormat)) + '</td>';
      }).join('') + '</tr></tfoot>';
    }

    stage.innerHTML = `<div class="sheet">
      ${th.watermark ? '<div class="sheet__watermark">' + U.esc(th.watermark) + '</div>' : ''}
      ${head}
      <div class="sheet__scroll"><table class="tbl">${thead}${tbody}${tfoot}</table></div>
      <div class="sheet__foot">
        <span>${U.esc(th.footer || 'Prepared with Quill & Grid')}</span>
        <span>${U.esc(t.meta && t.meta[0] ? t.meta[0][0] + ' ' + t.meta[0][1] : 'Sheet ' + t.id.toUpperCase())}</span>
      </div>
    </div>`;

    U.$('#tableTitle').textContent = t.title;
    U.$('#tableMeta').textContent = t.subtitle + ' · ' + cols.length + ' columns · ' + t.currency;
    const foot = U.$('#previewFoot');
    foot.hidden = false;
    U.$('#tableTicker').innerHTML =
      '<span><b>' + t.rows.length + '</b> rows</span>' +
      '<span><b>' + cols.length + '</b> cols</span>' +
      '<span><b>' + U.esc(t.intent) + '</b> layout</span>' +
      '<span><b>' + U.esc(QG.theme.get().headerStyle) + '</b> header</span>';

    QG.theme.renderColumns();
  }

  /* -------------------------------------------------------------- exports */
  function visible(t) { return t.columns.filter(c => !c.hidden); }

  function toCSV(t) {
    const cols = visible(t);
    const esc = v => {
      const s = String(v == null ? '' : v);
      return /[",\n]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s;
    };
    const lines = [cols.map(c => esc(c.label)).join(',')];
    t.rows.forEach(r => lines.push(cols.map(c => esc(rawValue(r, c))).join(',')));
    const totals = totalsFor(t, cols);
    if (QG.theme.get().showTotals && Object.keys(totals).length) {
      lines.push(cols.map((c, i) => i === 0 ? 'Total' : totals[c.key] != null ? totals[c.key] : '').join(','));
    }
    return '\uFEFF' + lines.join('\r\n');
  }

  function exportCSV() {
    const t = QG.state.table; if (!t) return warnEmpty();
    U.download(U.slug(t.title) + '-' + U.fmtDate(new Date()) + '.csv', toCSV(t), 'text/csv;charset=utf-8');
    U.toast('CSV downloaded — opens in Excel, Sheets or Numbers.', 'success');
    QG.sound.success();
  }

  function exportXLSX() {
    const t = QG.state.table; if (!t) return warnEmpty();
    if (!window.XLSX) {
      U.toast('Excel engine still loading — CSV downloaded instead.');
      return exportCSV();
    }
    const cols = visible(t);
    const aoa = [cols.map(c => c.label)];
    t.rows.forEach(r => aoa.push(cols.map(c => {
      const v = rawValue(r, c);
      return (c.type === 'money' || c.type === 'number') && v !== '' ? Number(v) : v;
    })));
    const totals = totalsFor(t, cols);
    if (QG.theme.get().showTotals && Object.keys(totals).length) {
      aoa.push(cols.map((c, i) => i === 0 ? 'Total' : totals[c.key] != null ? totals[c.key] : ''));
    }
    const ws = XLSX.utils.aoa_to_sheet(aoa);
    ws['!cols'] = cols.map(c => ({ wch: Math.max(12, Math.min(34, c.label.length + 6)) }));
    ws['!rows'] = aoa.map((_, i) => ({ hpt: i === 0 ? 22 : 18 }));
    const wb = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(wb, ws, t.title.slice(0, 28) || 'Sheet1');
    XLSX.writeFile(wb, U.slug(t.title) + '-' + U.fmtDate(new Date()) + '.xlsx');
    U.toast('Excel workbook exported with your column names.', 'success');
    QG.sound.success();
  }

  function exportJSON() {
    const t = QG.state.table; if (!t) return warnEmpty();
    const cols = visible(t);
    const data = t.rows.map(r => {
      const o = {};
      cols.forEach(c => { o[c.label] = rawValue(r, c); });
      return o;
    });
    U.download(U.slug(t.title) + '.json', JSON.stringify({ title: t.title, currency: t.currency, rows: data }, null, 2), 'application/json');
    U.toast('JSON exported for your own automations.', 'success');
  }

  /* Styled print — the export carries the user's palette, not a default one. */
  function exportStyled() {
    const t = QG.state.table; if (!t) return warnEmpty();
    const th = QG.theme.get();
    const cols = visible(t);
    const light = QG.theme.lum(th.bg) > 0.55;
    const paper = light ? '#ffffff' : '#0e1119';
    const ink = light ? '#15140f' : '#eaf0fb';
    const muted = light ? '#6d6a62' : '#93a1bb';
    const line = light ? 'rgba(0,0,0,.1)' : 'rgba(255,255,255,.1)';
    const totals = totalsFor(t, cols);
    const showTot = th.showTotals && Object.keys(totals).length;

    const headerCss = {
      fill: `background:${QG.theme.alpha(th.accent, 0.18)};color:${ink};`,
      line: `border-bottom:2px solid ${th.accent};color:${ink};`,
      pill: `background:${QG.theme.alpha(th.accent, 0.14)};color:${ink};`,
      gradient: `background:linear-gradient(100deg,${th.accent},${th.accent2});color:${QG.theme.lum(th.accent) > 0.62 ? '#0a0c14' : '#fff'};`,
      mono: `color:${th.accent};font-family:'IBM Plex Mono',monospace;`
    }[th.headerStyle] || '';

    const rowsHtml = t.rows.map((r, i) => '<tr' + (th.zebra && i % 2 ? ' class="z"' : '') + '>' +
      cols.map(c => {
        const isNum = c.type === 'money' || c.type === 'number';
        const val = c.type === 'money' ? U.money(r[c.key], th.currency, th.numFormat)
          : c.type === 'number' ? U.num(r[c.key], th.numFormat)
            : rawValue(r, c);
        return '<td class="' + (isNum ? 'n' : '') + '">' + U.esc(val) + '</td>';
      }).join('') + '</tr>').join('');

    const totalsHtml = showTot ? '<tr class="tot">' + cols.map((c, i) =>
      '<td class="' + (c.type === 'money' || c.type === 'number' ? 'n' : '') + '">' +
      (i === 0 ? 'Total' : totals[c.key] != null ? (c.type === 'money' ? U.money(totals[c.key], th.currency, th.numFormat) : U.num(totals[c.key], th.numFormat)) : '') +
      '</td>').join('') + '</tr>' : '';

    const html = `<!doctype html><html><head><meta charset="utf-8"><title>${U.esc(t.title)}</title>
      <style>
        @page{size:A4 landscape;margin:14mm}
        *{box-sizing:border-box}
        body{margin:0;background:${paper};color:${ink};font-family:'${th.font}',system-ui,sans-serif;font-size:${th.base - 1}px;padding:26px}
        .top{display:flex;justify-content:space-between;align-items:flex-start;gap:20px;margin-bottom:18px}
        .brand{font-size:9.5px;letter-spacing:.22em;text-transform:uppercase;color:${muted};display:flex;align-items:center;gap:7px}
        .brand:before{content:"";width:14px;height:2px;background:${th.accent}}
        h1{font-size:21px;margin:5px 0 3px;letter-spacing:-.02em}
        .sub{color:${muted};font-size:11px}
        .stamp{text-align:right;font-size:10px;color:${muted};line-height:1.7;border-left:1px solid ${line};padding-left:12px}
        .stamp b{display:block;color:${ink};font-size:12px}
        table{width:100%;border-collapse:collapse;font-size:${th.base - 3}px}
        th{font-size:9.5px;text-transform:uppercase;letter-spacing:.08em;text-align:left;padding:8px 9px;${headerCss}}
        td{padding:7px 9px;border-bottom:1px solid ${line}}
        .z{background:${light ? 'rgba(0,0,0,.025)' : 'rgba(255,255,255,.03)'}}
        .n{text-align:right;font-variant-numeric:tabular-nums}
        .tot td{font-weight:700;border-top:1px solid ${th.accent};background:${QG.theme.alpha(th.accent, 0.1)}}
        footer{display:flex;justify-content:space-between;margin-top:16px;padding-top:9px;border-top:1px dashed ${line};font-size:9.5px;color:${muted}}
        ${th.watermark ? `.wm{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;font-size:96px;font-weight:700;letter-spacing:.14em;color:${ink};opacity:.04;transform:rotate(-18deg);pointer-events:none}` : ''}
      </style></head><body>
      ${th.watermark ? '<div class="wm">' + U.esc(th.watermark) + '</div>' : ''}
      <div class="top">
        <div><div class="brand">${U.esc(th.company || 'Quill & Grid')}</div><h1>${U.esc(t.title)}</h1><div class="sub">${U.esc(t.subtitle || '')}</div></div>
        <div class="stamp"><b>${t.rows.length} rows</b>${cols.length} columns<br>${U.fmtDate(new Date())}<br>${U.esc(t.currency || th.currency)}</div>
      </div>
      <table><thead><tr>${cols.map(c => '<th' + (c.type === 'money' || c.type === 'number' ? ' style="text-align:right"' : '') + '>' + U.esc(c.label) + '</th>').join('')}</tr></thead>
      <tbody>${rowsHtml}${totalsHtml}</tbody></table>
      <footer><span>${U.esc(th.footer || '')}</span><span>${U.esc(th.company || 'Quill & Grid')}</span></footer>
      </body></html>`;

    const win = window.open('', '_blank', 'width=1024,height=768');
    if (!win) { U.toast('Allow pop-ups to open the styled print view.', 'error'); return; }
    win.document.open();
    win.document.write(html);
    win.document.close();
    setTimeout(() => { try { win.focus(); win.print(); } catch (e) {} }, 420);
    U.toast('Styled sheet opened — save as PDF from the print dialog.', 'success');
    QG.sound.success();
  }

  function warnEmpty() { U.toast('Generate a table first.', 'error'); QG.sound.error(); }

  /* ------------------------------------------------------------- pipeline */
  async function submit(prompt) {
    const text = String(prompt || '').trim();
    if (!text || busy) return;
    if (QG.access && !QG.access.requireAccess()) return;
    busy = true;
    const btn = U.$('#excelSend');
    if (btn) btn.disabled = true;

    bubble('me', U.esc(text));
    U.$('#excelInput').value = '';
    autosize(U.$('#excelInput'));

    /* 1 — is this a tweak to the sheet we already have? */
    const t = QG.state.table;
    if (t) {
      const op = QG.TableEngine.applyOp(t, text);
      if (op) {
        typing();
        await U.wait(520);
        endTyping();
        render();
        bubble('ai', op.reply + '<div class="bubble__hint">Everything stays editable in Design → Columns.</div>');
        QG.sound.click(1.1);
        busy = false;
        if (btn) btn.disabled = false;
        return;
      }
    }

    /* 2 — fresh generation, with the 5s staging */
    QG.sound.click();
    typing();
    const skeleton = '<div class="skel-table"><div class="r h"><div></div><div></div><div></div></div>' +
      '<div class="r"><div></div><div></div><div></div></div>'.repeat(5) + '</div>';
    U.$('#tableStage').innerHTML = skeleton;

    const jobs = {
      payroll: ['Reading the payroll brief', 'Assigning roles and base pay', 'Applying allowances and deductions', 'Balancing the net totals'],
      schedule: ['Reading the rota brief', 'Laying out the week', 'Assigning shifts and hours', 'Costing each day'],
      invoice: ['Reading the invoice brief', 'Pricing the line items', 'Applying tax-ready totals', 'Stamping the document'],
      inventory: ['Reading the stock brief', 'Building SKU codes', 'Counting units and reorder points', 'Flagging low stock'],
      budget: ['Reading the budget brief', 'Grouping categories', 'Comparing planned vs actual', 'Colouring the variances'],
      tasks: ['Reading the brief', 'Splitting into tasks', 'Assigning owners and dates', 'Balancing workload'],
      contacts: ['Reading the brief', 'Structuring the pipeline', 'Filling contact records', 'Scoring deal value'],
      sales: ['Reading the brief', 'Modelling units and prices', 'Computing revenue shares', 'Ranking the products'],
      generic: ['Reading the brief', 'Choosing the columns', 'Filling the rows', 'Polishing the layout']
    };
    const intent = QG.TableEngine.detectIntent(text.toLowerCase());

    await runJob({ steps: jobs[intent] || jobs.generic, ms: 5000 });
    endTyping();

    const table = QG.TableEngine.generate(text);
    QG.state.table = table;
    QG.state.lastPrompt = text;
    QG.theme.renderColumns();
    render();
    QG.sound.success();

    const summary = intent === 'schedule'
      ? 'Built a <b>' + table.rows.length + '-day rota</b> with ' + table.columns.length + ' columns.'
      : 'Built <b>' + U.esc(table.title.toLowerCase()) + '</b> — ' + table.rows.length + ' rows × ' + table.columns.length + ' columns.';

    bubble('ai', summary + ' Totals are live, currency is ' + table.currency + '.' +
      '<div class="bubble__hint">Refine it in words:</div>' +
      '<div class="bubble__chips">' +
      '<button data-follow="sort by net pay desc">sort by pay</button>' +
      '<button data-follow="rename Net pay to Take-home">rename a column</button>' +
      '<button data-follow="add column Notes">add a column</button>' +
      '<button data-follow="make it 14 rows">14 rows</button>' +
      '</div>');

    busy = false;
    if (btn) btn.disabled = false;
    U.$('#excelInput').focus();
  }

  /* -------------------------------------------------------------- helpers */
  function autosize(node) {
    if (!node) return;
    node.style.height = 'auto';
    node.style.height = Math.min(120, node.scrollHeight) + 'px';
  }

  function wire() {
    const form = U.$('#excelForm');
    const input = U.$('#excelInput');
    if (form) {
      form.addEventListener('submit', e => { e.preventDefault(); submit(input.value); });
    }
    if (input) {
      input.addEventListener('input', () => autosize(input));
      input.addEventListener('keydown', e => {
        if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); submit(input.value); }
      });
    }
    U.$$('#excelChips .chip').forEach(c => {
      c.addEventListener('click', () => { input.value = c.dataset.prompt; autosize(input); submit(c.dataset.prompt); });
    });
    document.addEventListener('click', e => {
      const f = e.target.closest('[data-follow]');
      if (f && f.closest('#excelChat')) { submit(f.dataset.follow); }
    });

    const microw = U.$('[data-act="excel-microw"]');
    if (microw) microw.addEventListener('click', () => {
      const ideas = [
        'Payroll for 6 employees this month in EGP with 15000 base salary',
        'Invoice for a branding project with 5 line items in USD',
        'Inventory for 12 products with reorder levels',
        'Budget vs actual for this month with 8 categories',
        'Task list for the launch sprint with 9 tasks',
        'Client pipeline with 10 contacts and deal values',
        'Sales report for Q4 with 7 products'
      ];
      input.value = ideas[Math.floor(Math.random() * ideas.length)];
      autosize(input);
      QG.sound.tick();
    });

    const shuffle = U.$('[data-act="shuffle-style"]');
    if (shuffle) shuffle.addEventListener('click', () => QG.theme.shuffle());

    const totalsBtn = U.$('[data-act="toggle-totals"]');
    if (totalsBtn) totalsBtn.addEventListener('click', () => {
      const th = QG.theme.get();
      QG.theme.set({ showTotals: !th.showTotals });
      U.toast(th.showTotals ? 'Totals row hidden.' : 'Totals row shown.');
    });

    /* export menu */
    const menu = U.$('#exportMenu');
    const toggle = U.$('[data-act="toggle-export"]');
    if (toggle && menu) {
      toggle.addEventListener('click', e => {
        e.stopPropagation();
        menu.classList.toggle('is-open');
        toggle.setAttribute('aria-expanded', menu.classList.contains('is-open') ? 'true' : 'false');
        QG.sound.click();
      });
      document.addEventListener('click', e => {
        if (!menu.contains(e.target)) { menu.classList.remove('is-open'); toggle.setAttribute('aria-expanded', 'false'); }
      });
    }
    document.addEventListener('click', e => {
      const b = e.target.closest('[data-export]');
      if (!b) return;
      menu.classList.remove('is-open');
      const kind = b.dataset.export;
      if (kind === 'csv') exportCSV();
      else if (kind === 'xlsx') exportXLSX();
      else if (kind === 'styled') exportStyled();
      else if (kind === 'json') exportJSON();
    });
  }

  QG.tableView = { wire, render, submit, exportCSV, exportXLSX, exportStyled, exportJSON };
})(window.QG);

</script>
